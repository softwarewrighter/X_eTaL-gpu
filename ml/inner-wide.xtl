#!/usr/bin/env xetal
# X_eTaL-ML's bench/inner-wide.xtl through the macro: the CNN's dense
# layer shape, a 1 x 1352 row by 1352 x 10, forty times, and the sum.
"gp:" u_se< "Gpu"
"ck:" u_se< "Clock"
u:f_ := "float float" gp:a_ccel< "{ x w -> '+ r_/ '{ i -> '+ r_/ r_avel x '+ '* i_nner w } e_ach r_ange 40 }"
x := 1 1352 r_eshape 0.5 0.25 0.125
w := 1352 10 r_eshape 0.01 -0.02 0.03
t1 := '{ a -> a u:f_ w } ck:t_ime x
t2 := '{ a -> a u:f_ w } ck:t_ime x
x u:f_ w
t1
t2
