#!/usr/bin/env xetal
# X_eTaL-ML's bench/softmax.xtl through the macro: nn:s_oftmax by row
# on 1000 x 64, ten times, and the sum (every row sums to one).
"gp:" u_se< "Gpu"
"ck:" u_se< "Clock"
"nn:" u_se< "NN"
u:f_ := "float" gp:a_ccel< "{ x -> '+ r_/ '{ i -> '+ r_/ r_avel nn:s_oftmax x } e_ach r_ange 10 }"
x := 1000 64 r_eshape 0.5 -1.25 2.0 0.0 3.5
t1 := 'u:f_ ck:t_ime x
t2 := 'u:f_ ck:t_ime x
u:f_ x
t1
t2
