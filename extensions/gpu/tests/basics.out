%a = input f64 [2 3]
%b = input f64 [3 2]
%c = matmul %a %b
output %c

%x = input f64 [2 3]
%wb = input f64 [4 2]
%w = drop -1 %wb
%t = take -1 %wb
%v = ravel %t
%o = const i64 [2] 0 1
%bias = table right %o %v
%xw = matmul %x %w
%y = map add %xw %bias
output %y

