#!/usr/bin/env bash
# The pinned xetal-x with the gpu extension (and X_eTaL-extensions'
# clock) loaded and this repository's
# libraries on XETAL_PATH, written relative to the current directory so
# baselines do not depend on the checkout. "xx run FILE" adds --seed 1
# --ascii, as the tests run; any other command passes through.
#   scripts/xx run prog.xtl
#   scripts/xx type extensions/gpu/lib/Gpu.xtl
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
[ -x "$root/bin/xetal-x" ] || "$root/scripts/xetal-extensions.sh" >/dev/null
rel() { python3 -c 'import os,sys; print(os.path.relpath(sys.argv[1]))' "$1"; }
XETAL_PATH="$(for d in "$root"/libs/*/src; do rel "$d"; done | paste -sd: -)"
export XETAL_PATH
# The gpu package, and X_eTaL-extensions' clock (ck:t_ime, for timing).
exts=(--ext "$(rel "$root/extensions/gpu")" --ext "$(rel "$root/work/xetal-extensions/extensions/clock")")
if [ "${1:-}" = run ]; then shift; exec "$root/bin/xetal-x" "${exts[@]}" run --seed 1 --ascii "$@"; fi
exec "$root/bin/xetal-x" "${exts[@]}" "$@"
