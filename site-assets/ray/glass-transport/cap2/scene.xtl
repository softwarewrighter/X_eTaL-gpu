## Shared dielectric sphere/crystal transport, using the validated Scene v2 bundle.
## Pinhole camera, deterministic sampled continuation and conservative opaque shadows.
"sc:" u_se< "Scene"
"gl:" u_se< "Glass"
"rt:" u_se< "RayTrace"
"studio" sc:s_cene2< "sphere mainball center 0 .85 0 radius .85 material solid\nsphere front center -1.55 .55 1.4 radius .55 material solid\nsphere rear center -1.7 .7 -1.6 radius .7 material solid\noctahedron right radii .55 .85 .55 material solid position 1.65 .85 .2\noctahedron frontgem radii .5 .65 .5 material solid position 2.9 .65 1.5\noctahedron backgem radii .65 1.05 .65 material solid position 1.5 1.05 -1.8\nfloor ground origin -12 0 -12 u 0 0 24 v 24 0 0 material slate\nfloor backpanel origin -4 3 -4 u 8 0 0 v 0 3 0 material panel\nfloor sidepanel origin -4 1 -3 u 0 4 0 v 0 0 4 material panel\ndielectric solid color 1 1 1 transmission 1 ior 1.5 absorption .01 .005 .002\nmaterial slate color .025 .03 .035 reflection .35\nmaterial panel color 1 1 1 reflection 0\nlight key position 3 6 -3 color 260 245 225\nlight fill position -3 4 5 color 35 45 65\ncamera eye 5 2.8 7 target 0 .8 0 up 0 1 0 fov 0.18"
triangles := ((studiotriangles sc:a_pplyGroups studiogroupids)_ studiotransforms)
spheres := ((studiospheres sc:a_pplySphereGroups studiospheregroupids)_ studiotransforms)
geometry := (triangles, spheres)
links := (studiotriangleids, studiosphereids, studiotriangleobjectids, studiosphereobjectids, studiomaterialids, studiospherematerialids)
## Bright panels use ordinary emission arrays until the emitter DSL lands.
emission := sc:e_mission 3 3 r_eshape 0 0 0  0 0 0  5 5 5
shading := (studiomaterials, studiomaterialkind, studiooptics, emission, studiolights)
scene := (geometry gl:p_reflight links)_ shading
clip := 0.00001 100.0 1e-10 0.000001
ambient := 0.02 0.025 0.035
background := 0.04 0.055 0.075
width := 2
height := 2
cap := 2
origins := studiocamera rt:o_rigins 1
directions := ((studiocamera rt:r_ays width c_at height)_ r_ange width * height)
## One camera origin is shared by this explicitly pinhole scene.
## GPU mapping uses scalar components until mapped cell results are supported.
u:g_lassChannels := { scene clip environment origin directions seed cap indices ->
  '{ index ->
    pixel := 1 + (index - 1) d_iv 3
    channel := 1 + (index - 1) m_od 3
    d := 1 3 r_eshape pixel s_elect directions
    medium := scene gl:m_ediums origin
    sample := 1 r_eshape pixel - 1
    color := (((((((scene gl:r_ender clip)_ environment)_ origin)_ d)_ medium)_ sample)_ seed c_at cap)
    channel s_elect r_avel color
  } e_ach indices
}
indices := f_loor f_loat r_ange 3 * width * height
linear := ((width * height) c_at 3) r_eshape (((((((scene u:g_lassChannels clip)_ 2 3 r_eshape ambient c_at background)_ origins)_ directions)_ 123)_ cap)_ indices)
display := 1.0 rt:s_rgb linear
r_avel linear
r_avel display
