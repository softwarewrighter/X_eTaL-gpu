def indexed_addr(
    b_sel_6: Pointer[Float32, ImmutAnyOrigin],
    dst: Pointer[Float32, MutAnyOrigin],
):
    var i = Int(block_idx.x * block_dim.x + thread_idx.x)
    if i < 8:
        var base = (i // 4) * 3 * 4 + i % 4
        var acc = b_sel_6[unsafe_offset=base + 2 * 4]
        var j = Int(3) - 2
        while j >= 0:
            acc = b_sel_6[unsafe_offset=base + j * 4] + acc
            j -= 1
        dst[unsafe_offset=i] = acc


@export("xir_init")
def xir_init() abi("C") -> Int32:
    """Initializes the Mojo runtime; 1 when this build targets a GPU, else 0."""
    initialize_runtime()
    comptime if has_accelerator():
        return 1
    else:
        return 0


@export("xir_device_info")
def xir_device_info(buf: Pointer[UInt8, MutAnyOrigin], cap: Int64) abi("C") -> Int64:
    """Writes `api=...;name=...` for the device the kernels run on; its length, or -1."""
    initialize_runtime()
    try:
        var ctx = DeviceContext()
        var s = String("api=", ctx.api(), ";name=", ctx.name())
        var bytes = s.as_bytes()
        var n = min(len(bytes), Int(cap))
        for i in range(n):
            buf[unsafe_offset=i] = bytes[i]
        return Int64(n)
    except e:
        return -1


@export("xir_run")
def xir_run(
    inputs: Pointer[Pointer[UInt8, ImmutAnyOrigin], ImmutAnyOrigin],
    outputs: Pointer[Pointer[UInt8, MutAnyOrigin], ImmutAnyOrigin],
) abi("C") -> Int32:
    """Runs the program: inputs[k] as the ABI lists them (the program's
    inputs, then the uploaded constants), outputs[j] in output order, every
    array as Float64, Int64 or Int32 Bool items on the host, converted
    to the scheduled device width here.

    Returns 0 when done, 1 when the device failed.
    """
    initialize_runtime()
    try:
        var ctx = DeviceContext()
        var h_v = ctx.enqueue_create_host_buffer[DType.int64](5)
        for i in range(5):
            h_v[i] = Int64(inputs[unsafe_offset=0].bitcast[Int64]()[unsafe_offset=i])
        var h_ids_2 = ctx.enqueue_create_host_buffer[DType.int64](3)
        for i in range(3):
            h_ids_2[i] = Int64(inputs[unsafe_offset=1].bitcast[Int64]()[unsafe_offset=i])
        var h_ids_3 = ctx.enqueue_create_host_buffer[DType.int64](4)
        for i in range(4):
            h_ids_3[i] = Int64(inputs[unsafe_offset=2].bitcast[Int64]()[unsafe_offset=i])
        var h_m = ctx.enqueue_create_host_buffer[DType.int64](6)
        for i in range(6):
            h_m[i] = Int64(inputs[unsafe_offset=3].bitcast[Int64]()[unsafe_offset=i])
        var h_ids_4 = ctx.enqueue_create_host_buffer[DType.int64](2)
        for i in range(2):
            h_ids_4[i] = Int64(inputs[unsafe_offset=4].bitcast[Int64]()[unsafe_offset=i])
        var h_ids_5 = ctx.enqueue_create_host_buffer[DType.int64](2)
        for i in range(2):
            h_ids_5[i] = Int64(inputs[unsafe_offset=5].bitcast[Int64]()[unsafe_offset=i])
        var h_t = ctx.enqueue_create_host_buffer[DType.float32](20)
        for i in range(20):
            h_t[i] = Float32(inputs[unsafe_offset=6].bitcast[Float64]()[unsafe_offset=i])
        var h_ids_6 = ctx.enqueue_create_host_buffer[DType.int64](6)
        for i in range(6):
            h_ids_6[i] = Int64(inputs[unsafe_offset=7].bitcast[Int64]()[unsafe_offset=i])
        # device buffers, one per materialized value
        var b_v = ctx.enqueue_create_buffer[DType.int64](5)
        ctx.enqueue_copy(dst_buf=b_v, src_buf=h_v)
        var b_ids = ctx.enqueue_create_buffer[DType.int64](1)
        b_ids.enqueue_fill(Int64(2))
        var b_sel = ctx.enqueue_create_buffer[DType.int64](1)
        var b_ids_2 = ctx.enqueue_create_buffer[DType.int64](3)
        ctx.enqueue_copy(dst_buf=b_ids_2, src_buf=h_ids_2)
        var b_sel_2 = ctx.enqueue_create_buffer[DType.int64](3)
        var b_ids_3 = ctx.enqueue_create_buffer[DType.int64](4)
        ctx.enqueue_copy(dst_buf=b_ids_3, src_buf=h_ids_3)
        var b_sel_3 = ctx.enqueue_create_buffer[DType.int64](4)
        var b_m = ctx.enqueue_create_buffer[DType.int64](6)
        ctx.enqueue_copy(dst_buf=b_m, src_buf=h_m)
        var b_ids_4 = ctx.enqueue_create_buffer[DType.int64](2)
        ctx.enqueue_copy(dst_buf=b_ids_4, src_buf=h_ids_4)
        var b_sel_4 = ctx.enqueue_create_buffer[DType.int64](4)
        var b_ids_5 = ctx.enqueue_create_buffer[DType.int64](2)
        ctx.enqueue_copy(dst_buf=b_ids_5, src_buf=h_ids_5)
        var b_sel_5 = ctx.enqueue_create_buffer[DType.int64](6)
        var b_t = ctx.enqueue_create_buffer[DType.float32](20)
        ctx.enqueue_copy(dst_buf=b_t, src_buf=h_t)
        var b_ids_6 = ctx.enqueue_create_buffer[DType.int64](6)
        ctx.enqueue_copy(dst_buf=b_ids_6, src_buf=h_ids_6)
        var b_sel_6 = ctx.enqueue_create_buffer[DType.float32](24)
        var b_addr = ctx.enqueue_create_buffer[DType.float32](8)
        ctx.enqueue_function[indexed_sel](b_v, b_ids, b_sel, grid_dim=1, block_dim=TPB)
        ctx.enqueue_function[indexed_sel_2](b_v, b_ids_2, b_sel_2, grid_dim=1, block_dim=TPB)
        ctx.enqueue_function[indexed_sel_3](b_v, b_ids_3, b_sel_3, grid_dim=1, block_dim=TPB)
        ctx.enqueue_function[indexed_sel_4](b_m, b_ids_4, b_sel_4, grid_dim=1, block_dim=TPB)
        ctx.enqueue_function[indexed_sel_5](b_m, b_ids_5, b_sel_5, grid_dim=1, block_dim=TPB)
        ctx.enqueue_function[indexed_sel_6](b_t, b_ids_6, b_sel_6, grid_dim=1, block_dim=TPB)
        ctx.enqueue_function[indexed_addr](b_sel_6, b_addr, grid_dim=1, block_dim=TPB)
        # the outputs, back to the host
        var o_0 = ctx.enqueue_create_host_buffer[DType.int64](1)
        ctx.enqueue_copy(dst_buf=o_0, src_buf=b_sel)
        var o_1 = ctx.enqueue_create_host_buffer[DType.int64](3)
        ctx.enqueue_copy(dst_buf=o_1, src_buf=b_sel_2)
        var o_2 = ctx.enqueue_create_host_buffer[DType.int64](4)
        ctx.enqueue_copy(dst_buf=o_2, src_buf=b_sel_3)
        var o_3 = ctx.enqueue_create_host_buffer[DType.int64](4)
        ctx.enqueue_copy(dst_buf=o_3, src_buf=b_sel_4)
        var o_4 = ctx.enqueue_create_host_buffer[DType.int64](6)
        ctx.enqueue_copy(dst_buf=o_4, src_buf=b_sel_5)
        var o_5 = ctx.enqueue_create_host_buffer[DType.float32](24)
        ctx.enqueue_copy(dst_buf=o_5, src_buf=b_sel_6)
        var o_6 = ctx.enqueue_create_host_buffer[DType.float32](8)
        ctx.enqueue_copy(dst_buf=o_6, src_buf=b_addr)
        ctx.synchronize()
        for i in range(1):
            outputs[unsafe_offset=0].bitcast[Int64]()[unsafe_offset=i] = Int64(o_0[i])
        for i in range(3):
            outputs[unsafe_offset=1].bitcast[Int64]()[unsafe_offset=i] = Int64(o_1[i])
        for i in range(4):
            outputs[unsafe_offset=2].bitcast[Int64]()[unsafe_offset=i] = Int64(o_2[i])
        for i in range(4):
            outputs[unsafe_offset=3].bitcast[Int64]()[unsafe_offset=i] = Int64(o_3[i])
        for i in range(6):
            outputs[unsafe_offset=4].bitcast[Int64]()[unsafe_offset=i] = Int64(o_4[i])
        for i in range(24):
            outputs[unsafe_offset=5].bitcast[Float64]()[unsafe_offset=i] = Float64(o_5[i])
        for i in range(8):
            outputs[unsafe_offset=6].bitcast[Float64]()[unsafe_offset=i] = Float64(o_6[i])
        return 0
    except e:
        print("xir_run failed:", e)
        return 1
