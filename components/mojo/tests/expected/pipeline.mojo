# pipeline.mojo: generated by xetal-gpu (components/mojo) from pipeline. Do not edit.
# 2 fused kernel stage(s), 2 reduction(s), 8 device buffer(s).

from std.math import exp, log, cos, sin, sqrt, floor, inf, nan
from std.memory import unsafe_stack_allocation
from std.runtime import initialize_runtime
from std.sys import has_accelerator

from max.gpu import block_dim, block_idx, thread_idx
from max.gpu.host import DeviceContext
from max.gpu.sync import barrier

comptime TPB = 256

def reduce_add_float32(
    src: Pointer[Float32, ImmutAnyOrigin],
    dst: Pointer[Float32, MutAnyOrigin],
    n: Int32,
):
    """One block folds TPB items of src into dst[block]: a tree in shared memory."""
    var shared = unsafe_stack_allocation[TPB, Float32, address_space=.SHARED]()
    var tid = Int(thread_idx.x)
    var i = Int(block_idx.x) * TPB + tid
    var v: Float32 = Float32(0)
    if i < Int(n):
        v = src[unsafe_offset=i]
    shared[unsafe_offset=tid] = v
    barrier()
    var active = TPB // 2
    while active > 0:
        if tid < active:
            var lhs = shared[unsafe_offset=tid]
            var rhs = shared[unsafe_offset=tid + active]
            shared[unsafe_offset=tid] = lhs + rhs
        barrier()
        active //= 2
    if tid == 0:
        dst[unsafe_offset=Int(block_idx.x)] = shared[unsafe_offset=0][0]

def reduce_add_int64(
    src: Pointer[Int64, ImmutAnyOrigin],
    dst: Pointer[Int64, MutAnyOrigin],
    n: Int32,
):
    """One block folds TPB items of src into dst[block]: a tree in shared memory."""
    var shared = unsafe_stack_allocation[TPB, Int64, address_space=.SHARED]()
    var tid = Int(thread_idx.x)
    var i = Int(block_idx.x) * TPB + tid
    var v: Int64 = Int64(0)
    if i < Int(n):
        v = src[unsafe_offset=i]
    shared[unsafe_offset=tid] = v
    barrier()
    var active = TPB // 2
    while active > 0:
        if tid < active:
            var lhs = shared[unsafe_offset=tid]
            var rhs = shared[unsafe_offset=tid + active]
            shared[unsafe_offset=tid] = lhs + rhs
        barrier()
        active //= 2
    if tid == 0:
        dst[unsafe_offset=Int(block_idx.x)] = shared[unsafe_offset=0][0]

def stage0(
    b_x: Pointer[Int64, ImmutAnyOrigin],
    b_w: Pointer[Int64, ImmutAnyOrigin],
    b_max: Pointer[Int64, MutAnyOrigin],
    n: Int32,
):
    """Stage 0: %mul, %add, %max fused, one thread per element."""
    var i = Int(block_idx.x * block_dim.x + thread_idx.x)
    if i < Int(n):
        var v_x = b_x[unsafe_offset=i]
        var v_w = b_w[unsafe_offset=i]
        var v_mul = v_x * v_w
        var v_add = v_x + v_mul
        var v_max = max(v_add, Int64(0))
        b_max[unsafe_offset=i] = v_max

def stage1(
    b_l: Pointer[Float32, ImmutAnyOrigin],
    b_g: Pointer[Float32, ImmutAnyOrigin],
    b_max_2: Pointer[Float32, MutAnyOrigin],
    n: Int32,
):
    """Stage 1: %div, %mul_2, %add_2, %max_2 fused, one thread per element."""
    var i = Int(block_idx.x * block_dim.x + thread_idx.x)
    if i < Int(n):
        var v_l = b_l[unsafe_offset=i]
        var v_g = b_g[unsafe_offset=i]
        var v_div = v_l / Float32(4.0)
        var v_mul_2 = v_div * v_g
        var v_add_2 = v_div + v_mul_2
        var v_max_2 = max(v_add_2, Float32(0.0))
        b_max_2[unsafe_offset=i] = v_max_2


@export("xir_init")
def xir_init() abi("C") -> Int32:
    """Initializes the Mojo runtime; 1 when this build targets a GPU, else 0."""
    initialize_runtime()
    comptime if has_accelerator():
        return 1
    else:
        return 0


@export("xir_device_info")
def xir_device_info(buf: Pointer[UInt8, MutAnyOrigin], cap: Int64) abi("C") -> Int64:
    """Writes `api=...;name=...` for the device the kernels run on; its length, or -1."""
    initialize_runtime()
    try:
        var ctx = DeviceContext()
        var s = String("api=", ctx.api(), ";name=", ctx.name())
        var bytes = s.as_bytes()
        var n = min(len(bytes), Int(cap))
        for i in range(n):
            buf[unsafe_offset=i] = bytes[i]
        return Int64(n)
    except e:
        return -1


@export("xir_run")
def xir_run(
    inputs: Pointer[Pointer[Float64, ImmutAnyOrigin], ImmutAnyOrigin],
    outputs: Pointer[Pointer[Float64, MutAnyOrigin], ImmutAnyOrigin],
) abi("C") -> Int32:
    """Runs the program: inputs[k] as the ABI lists them (the program's
    inputs, then the uploaded constants), outputs[j] in output order, every
    array as Float64 items on the host (converted to the device's width here).

    Returns 0 when done, 1 when the device failed.
    """
    initialize_runtime()
    try:
        var ctx = DeviceContext()
        var h_x = ctx.enqueue_create_host_buffer[DType.int64](8)
        for i in range(8):
            h_x[i] = Int64(inputs[unsafe_offset=0][unsafe_offset=i])
        var h_w = ctx.enqueue_create_host_buffer[DType.int64](8)
        for i in range(8):
            h_w[i] = Int64(inputs[unsafe_offset=1][unsafe_offset=i])
        var h_l = ctx.enqueue_create_host_buffer[DType.float32](8)
        for i in range(8):
            h_l[i] = Float32(inputs[unsafe_offset=2][unsafe_offset=i])
        var h_g = ctx.enqueue_create_host_buffer[DType.float32](8)
        for i in range(8):
            h_g[i] = Float32(inputs[unsafe_offset=3][unsafe_offset=i])
        # device buffers, one per materialized value
        var b_x = ctx.enqueue_create_buffer[DType.int64](8)
        ctx.enqueue_copy(dst_buf=b_x, src_buf=h_x)
        var b_w = ctx.enqueue_create_buffer[DType.int64](8)
        ctx.enqueue_copy(dst_buf=b_w, src_buf=h_w)
        var b_max = ctx.enqueue_create_buffer[DType.int64](8)
        var b_addr = ctx.enqueue_create_buffer[DType.int64](1)
        var b_l = ctx.enqueue_create_buffer[DType.float32](8)
        ctx.enqueue_copy(dst_buf=b_l, src_buf=h_l)
        var b_g = ctx.enqueue_create_buffer[DType.float32](8)
        ctx.enqueue_copy(dst_buf=b_g, src_buf=h_g)
        var b_max_2 = ctx.enqueue_create_buffer[DType.float32](8)
        var b_addr_2 = ctx.enqueue_create_buffer[DType.float32](1)
        # stage 0: 8 element(s), 1 block(s) of TPB
        ctx.enqueue_function[stage0](b_x, b_w, b_max, Int32(8), grid_dim=1, block_dim=TPB)
        # reduce add %max -> %addr: a partial per block of 256, until one is left (1 pass(es))
        ctx.enqueue_function[reduce_add_int64](b_max, b_addr, Int32(8), grid_dim=1, block_dim=TPB)
        # stage 1: 8 element(s), 1 block(s) of TPB
        ctx.enqueue_function[stage1](b_l, b_g, b_max_2, Int32(8), grid_dim=1, block_dim=TPB)
        # reduce add %max_2 -> %addr_2: a partial per block of 256, until one is left (1 pass(es))
        ctx.enqueue_function[reduce_add_float32](b_max_2, b_addr_2, Int32(8), grid_dim=1, block_dim=TPB)
        # the outputs, back to the host
        var o_0 = ctx.enqueue_create_host_buffer[DType.int64](1)
        ctx.enqueue_copy(dst_buf=o_0, src_buf=b_addr)
        var o_1 = ctx.enqueue_create_host_buffer[DType.float32](1)
        ctx.enqueue_copy(dst_buf=o_1, src_buf=b_addr_2)
        ctx.synchronize()
        for i in range(1):
            outputs[unsafe_offset=0][unsafe_offset=i] = Float64(o_0[i])
        for i in range(1):
            outputs[unsafe_offset=1][unsafe_offset=i] = Float64(o_1[i])
        return 0
    except e:
        print("xir_run failed:", e)
        return 1
