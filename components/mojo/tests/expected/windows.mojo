        var b_x = ctx.enqueue_create_buffer[DType.float32](24)
        ctx.enqueue_copy(dst_buf=b_x, src_buf=h_x)
        var b_rot_3 = ctx.enqueue_create_buffer[DType.float32](72)
        var b_rot_4 = ctx.enqueue_create_buffer[DType.float32](216)
        var b_drop = ctx.enqueue_create_buffer[DType.float32](144)
        var b_drop_2 = ctx.enqueue_create_buffer[DType.float32](72)
        var b_drop_3 = ctx.enqueue_create_buffer[DType.float32](54)
        var b_drop_4 = ctx.enqueue_create_buffer[DType.float32](36)
        var b_rs = ctx.enqueue_create_buffer[DType.float32](36)
        var b_k = ctx.enqueue_create_buffer[DType.float32](18)
        ctx.enqueue_copy(dst_buf=b_k, src_buf=h_k)
        var b_rot_5 = ctx.enqueue_create_buffer[DType.float32](72)
        var b_rot_6 = ctx.enqueue_create_buffer[DType.float32](216)
        var b_drop_5 = ctx.enqueue_create_buffer[DType.float32](144)
        var b_drop_6 = ctx.enqueue_create_buffer[DType.float32](72)
        var b_drop_7 = ctx.enqueue_create_buffer[DType.float32](54)
        var b_drop_8 = ctx.enqueue_create_buffer[DType.float32](36)
        var b_rs_2 = ctx.enqueue_create_buffer[DType.float32](36)
        var b_mm = ctx.enqueue_create_buffer[DType.float32](8)
        var b_rs_3 = ctx.enqueue_create_buffer[DType.float32](8)
        var b_tr = ctx.enqueue_create_buffer[DType.float32](8)
        var b_rs_4 = ctx.enqueue_create_buffer[DType.float32](8)
