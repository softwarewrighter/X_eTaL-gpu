            outputs[unsafe_offset=0].bitcast[Int64]()[unsafe_offset=i] = Int64(o_0[i])
        for i in range(15):
            outputs[unsafe_offset=1].bitcast[Int64]()[unsafe_offset=i] = Int64(o_1[i])
        for i in range(36):
            outputs[unsafe_offset=2].bitcast[Float64]()[unsafe_offset=i] = Float64(o_2[i])
        for i in range(8):
            outputs[unsafe_offset=3].bitcast[Float64]()[unsafe_offset=i] = Float64(o_3[i])
        return 0
    except e:
        print("xir_run failed:", e)
        return 1
