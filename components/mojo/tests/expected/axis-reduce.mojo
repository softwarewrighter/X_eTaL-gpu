# axis_reduce.mojo: generated by xetal-gpu (components/mojo) from axis_reduce. Do not edit.
# 1 fused kernel stage(s), 1 reduction(s), 10 device buffer(s).
# 6 indexed kernel(s), one thread per result.

from std.math import exp, log, cos, sin, sqrt, floor, inf, nan
from std.memory import unsafe_stack_allocation
from std.runtime import initialize_runtime
from std.sys import has_accelerator

from max.gpu import block_dim, block_idx, thread_idx
from max.gpu.host import DeviceContext
from max.gpu.sync import barrier

comptime TPB = 256

def reduce_add_float32(
    src: Pointer[Float32, ImmutAnyOrigin],
    dst: Pointer[Float32, MutAnyOrigin],
    n: Int32,
):
    """One block folds TPB items of src into dst[block]: a tree in shared memory."""
    var shared = unsafe_stack_allocation[TPB, Float32, address_space=.SHARED]()
    var tid = Int(thread_idx.x)
    var i = Int(block_idx.x) * TPB + tid
    var v: Float32 = Float32(0)
    if i < Int(n):
        v = src[unsafe_offset=i]
    shared[unsafe_offset=tid] = v
    barrier()
    var active = TPB // 2
    while active > 0:
        if tid < active:
            var lhs = shared[unsafe_offset=tid]
            var rhs = shared[unsafe_offset=tid + active]
            shared[unsafe_offset=tid] = lhs + rhs
        barrier()
        active //= 2
    if tid == 0:
        dst[unsafe_offset=Int(block_idx.x)] = shared[unsafe_offset=0][0]

def indexed_addr(
    b_m: Pointer[Int64, ImmutAnyOrigin],
    dst: Pointer[Int64, MutAnyOrigin],
):
    var i = Int(block_idx.x * block_dim.x + thread_idx.x)
    if i < 3:
        var base = (i // 1) * 4 * 1 + i % 1
        var acc = b_m[unsafe_offset=base + 3 * 1]
        var j = Int(4) - 2
        while j >= 0:
            acc = b_m[unsafe_offset=base + j * 1] + acc
            j -= 1
        dst[unsafe_offset=i] = acc

def indexed_addr_2(
    b_m: Pointer[Int64, ImmutAnyOrigin],
    dst: Pointer[Int64, MutAnyOrigin],
):
    var i = Int(block_idx.x * block_dim.x + thread_idx.x)
    if i < 4:
        var base = (i // 4) * 3 * 4 + i % 4
        var acc = b_m[unsafe_offset=base + 2 * 4]
        var j = Int(3) - 2
        while j >= 0:
            acc = b_m[unsafe_offset=base + j * 4] + acc
            j -= 1
        dst[unsafe_offset=i] = acc

def indexed_maxr(
    b_m: Pointer[Int64, ImmutAnyOrigin],
    dst: Pointer[Int64, MutAnyOrigin],
):
    var i = Int(block_idx.x * block_dim.x + thread_idx.x)
    if i < 3:
        var base = (i // 1) * 4 * 1 + i % 1
        var acc = b_m[unsafe_offset=base + 3 * 1]
        var j = Int(4) - 2
        while j >= 0:
            acc = max(b_m[unsafe_offset=base + j * 1], acc)
            j -= 1
        dst[unsafe_offset=i] = acc

def indexed_addr_3(
    b_div: Pointer[Float32, ImmutAnyOrigin],
    dst: Pointer[Float32, MutAnyOrigin],
):
    var i = Int(block_idx.x * block_dim.x + thread_idx.x)
    if i < 3:
        var base = (i // 1) * 4 * 1 + i % 1
        var acc = b_div[unsafe_offset=base + 3 * 1]
        var j = Int(4) - 2
        while j >= 0:
            acc = b_div[unsafe_offset=base + j * 1] + acc
            j -= 1
        dst[unsafe_offset=i] = acc

def indexed_addr_4(
    b_div: Pointer[Float32, ImmutAnyOrigin],
    dst: Pointer[Float32, MutAnyOrigin],
):
    var i = Int(block_idx.x * block_dim.x + thread_idx.x)
    if i < 4:
        var base = (i // 4) * 3 * 4 + i % 4
        var acc = b_div[unsafe_offset=base + 2 * 4]
        var j = Int(3) - 2
        while j >= 0:
            acc = b_div[unsafe_offset=base + j * 4] + acc
            j -= 1
        dst[unsafe_offset=i] = acc

def indexed_addr_5(
    b_div: Pointer[Float32, ImmutAnyOrigin],
    dst: Pointer[Float32, MutAnyOrigin],
):
    var i = Int(block_idx.x * block_dim.x + thread_idx.x)
    if i < 3:
        var base = (i // 1) * 4 * 1 + i % 1
        var acc = b_div[unsafe_offset=base + 3 * 1]
        var j = Int(4) - 2
        while j >= 0:
            acc = b_div[unsafe_offset=base + j * 1] + acc
            j -= 1
        dst[unsafe_offset=i] = acc

def stage0(
    b_l: Pointer[Float32, ImmutAnyOrigin],
    b_div: Pointer[Float32, MutAnyOrigin],
    n: Int32,
):
    """Stage 0: %div fused, one thread per element."""
    var i = Int(block_idx.x * block_dim.x + thread_idx.x)
    if i < Int(n):
        var v_l = b_l[unsafe_offset=i]
        var v_div = v_l / Float32(8.0)
        b_div[unsafe_offset=i] = v_div


@export("xir_init")
def xir_init() abi("C") -> Int32:
    """Initializes the Mojo runtime; 1 when this build targets a GPU, else 0."""
    initialize_runtime()
    comptime if has_accelerator():
        return 1
    else:
        return 0


@export("xir_device_info")
def xir_device_info(buf: Pointer[UInt8, MutAnyOrigin], cap: Int64) abi("C") -> Int64:
    """Writes `api=...;name=...` for the device the kernels run on; its length, or -1."""
    initialize_runtime()
    try:
        var ctx = DeviceContext()
        var s = String("api=", ctx.api(), ";name=", ctx.name())
        var bytes = s.as_bytes()
        var n = min(len(bytes), Int(cap))
        for i in range(n):
            buf[unsafe_offset=i] = bytes[i]
        return Int64(n)
    except e:
        return -1


@export("xir_run")
def xir_run(
    inputs: Pointer[Pointer[UInt8, ImmutAnyOrigin], ImmutAnyOrigin],
    outputs: Pointer[Pointer[UInt8, MutAnyOrigin], ImmutAnyOrigin],
) abi("C") -> Int32:
    """Runs the program: inputs[k] as the ABI lists them (the program's
    inputs, then the uploaded constants), outputs[j] in output order, every
    array as Float64, Int64 or Int32 Bool items on the host, converted
    to the scheduled device width here.

    Returns 0 when done, 1 when the device failed.
    """
    initialize_runtime()
    try:
        var ctx = DeviceContext()
        var h_m = ctx.enqueue_create_host_buffer[DType.int64](12)
        for i in range(12):
            h_m[i] = Int64(inputs[unsafe_offset=0].bitcast[Int64]()[unsafe_offset=i])
        var h_l = ctx.enqueue_create_host_buffer[DType.float32](12)
        for i in range(12):
            h_l[i] = Float32(inputs[unsafe_offset=1].bitcast[Float64]()[unsafe_offset=i])
        # device buffers, one per materialized value
        var b_m = ctx.enqueue_create_buffer[DType.int64](12)
        ctx.enqueue_copy(dst_buf=b_m, src_buf=h_m)
        var b_addr = ctx.enqueue_create_buffer[DType.int64](3)
        var b_addr_2 = ctx.enqueue_create_buffer[DType.int64](4)
        var b_maxr = ctx.enqueue_create_buffer[DType.int64](3)
        var b_l = ctx.enqueue_create_buffer[DType.float32](12)
        ctx.enqueue_copy(dst_buf=b_l, src_buf=h_l)
        var b_div = ctx.enqueue_create_buffer[DType.float32](12)
        var b_addr_3 = ctx.enqueue_create_buffer[DType.float32](3)
        var b_addr_4 = ctx.enqueue_create_buffer[DType.float32](4)
        var b_addr_5 = ctx.enqueue_create_buffer[DType.float32](3)
        var b_addr_6 = ctx.enqueue_create_buffer[DType.float32](1)
        ctx.enqueue_function[indexed_addr](b_m, b_addr, grid_dim=1, block_dim=TPB)
        ctx.enqueue_function[indexed_addr_2](b_m, b_addr_2, grid_dim=1, block_dim=TPB)
        ctx.enqueue_function[indexed_maxr](b_m, b_maxr, grid_dim=1, block_dim=TPB)
        # stage 0: 12 element(s), 1 block(s) of TPB
        ctx.enqueue_function[stage0](b_l, b_div, Int32(12), grid_dim=1, block_dim=TPB)
        ctx.enqueue_function[indexed_addr_3](b_div, b_addr_3, grid_dim=1, block_dim=TPB)
        ctx.enqueue_function[indexed_addr_4](b_div, b_addr_4, grid_dim=1, block_dim=TPB)
        ctx.enqueue_function[indexed_addr_5](b_div, b_addr_5, grid_dim=1, block_dim=TPB)
        # reduce add %addr_5 -> %addr_6: a partial per block of 256, until one is left (1 pass(es))
        ctx.enqueue_function[reduce_add_float32](b_addr_5, b_addr_6, Int32(3), grid_dim=1, block_dim=TPB)
        # the outputs, back to the host
        var o_0 = ctx.enqueue_create_host_buffer[DType.int64](12)
        ctx.enqueue_copy(dst_buf=o_0, src_buf=b_m)
        var o_1 = ctx.enqueue_create_host_buffer[DType.int64](3)
        ctx.enqueue_copy(dst_buf=o_1, src_buf=b_addr)
        var o_2 = ctx.enqueue_create_host_buffer[DType.int64](4)
        ctx.enqueue_copy(dst_buf=o_2, src_buf=b_addr_2)
        var o_3 = ctx.enqueue_create_host_buffer[DType.int64](3)
        ctx.enqueue_copy(dst_buf=o_3, src_buf=b_maxr)
        var o_4 = ctx.enqueue_create_host_buffer[DType.float32](3)
        ctx.enqueue_copy(dst_buf=o_4, src_buf=b_addr_3)
        var o_5 = ctx.enqueue_create_host_buffer[DType.float32](4)
        ctx.enqueue_copy(dst_buf=o_5, src_buf=b_addr_4)
        var o_6 = ctx.enqueue_create_host_buffer[DType.float32](1)
        ctx.enqueue_copy(dst_buf=o_6, src_buf=b_addr_6)
        ctx.synchronize()
        for i in range(12):
            outputs[unsafe_offset=0].bitcast[Int64]()[unsafe_offset=i] = Int64(o_0[i])
        for i in range(3):
            outputs[unsafe_offset=1].bitcast[Int64]()[unsafe_offset=i] = Int64(o_1[i])
        for i in range(4):
            outputs[unsafe_offset=2].bitcast[Int64]()[unsafe_offset=i] = Int64(o_2[i])
        for i in range(3):
            outputs[unsafe_offset=3].bitcast[Int64]()[unsafe_offset=i] = Int64(o_3[i])
        for i in range(3):
            outputs[unsafe_offset=4].bitcast[Float64]()[unsafe_offset=i] = Float64(o_4[i])
        for i in range(4):
            outputs[unsafe_offset=5].bitcast[Float64]()[unsafe_offset=i] = Float64(o_5[i])
        for i in range(1):
            outputs[unsafe_offset=6].bitcast[Float64]()[unsafe_offset=i] = Float64(o_6[i])
        return 0
    except e:
        print("xir_run failed:", e)
        return 1
