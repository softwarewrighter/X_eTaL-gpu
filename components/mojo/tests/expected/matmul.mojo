# matmul.mojo: generated by xetal-gpu (components/mojo) from matmul. Do not edit.
# 1 fused kernel stage(s), 0 reduction(s), 12 device buffer(s).
# 4 indexed kernel(s), one thread per result.

from std.math import exp, log, cos, sin, sqrt, floor, inf, nan
from std.memory import unsafe_stack_allocation
from std.runtime import initialize_runtime
from std.sys import has_accelerator

from max.gpu import block_dim, block_idx, thread_idx
from max.gpu.host import DeviceContext
from max.gpu.sync import barrier

comptime TPB = 256

def indexed_mm(
    b_a: Pointer[Int64, ImmutAnyOrigin],
    b_b: Pointer[Int64, ImmutAnyOrigin],
    dst: Pointer[Int64, MutAnyOrigin],
):
    var i = Int(block_idx.x * block_dim.x + thread_idx.x)
    if i < 6:
        var acc = b_a[unsafe_offset=(i // 2) * 4 + 3] * b_b[unsafe_offset=3 * 2 + i % 2]
        var j = Int(4) - 2
        while j >= 0:
            acc = b_a[unsafe_offset=(i // 2) * 4 + j] * b_b[unsafe_offset=j * 2 + i % 2] + acc
            j -= 1
        dst[unsafe_offset=i] = acc

def indexed_mm_2(
    b_a: Pointer[Int64, ImmutAnyOrigin],
    b_b_2: Pointer[Int64, ImmutAnyOrigin],
    dst: Pointer[Int64, MutAnyOrigin],
):
    var i = Int(block_idx.x * block_dim.x + thread_idx.x)
    if i < 3:
        var acc = b_a[unsafe_offset=(i // 1) * 4 + 3] * b_b_2[unsafe_offset=3 * 1 + i % 1]
        var j = Int(4) - 2
        while j >= 0:
            acc = b_a[unsafe_offset=(i // 1) * 4 + j] * b_b_2[unsafe_offset=j * 1 + i % 1] + acc
            j -= 1
        dst[unsafe_offset=i] = acc

def indexed_mm_3(
    b_a: Pointer[Int64, ImmutAnyOrigin],
    b_a_2: Pointer[Int64, ImmutAnyOrigin],
    dst: Pointer[Int64, MutAnyOrigin],
):
    var i = Int(block_idx.x * block_dim.x + thread_idx.x)
    if i < 4:
        var acc = b_a_2[unsafe_offset=(i // 4) * 3 + 2] * b_a[unsafe_offset=2 * 4 + i % 4]
        var j = Int(3) - 2
        while j >= 0:
            acc = b_a_2[unsafe_offset=(i // 4) * 3 + j] * b_a[unsafe_offset=j * 4 + i % 4] + acc
            j -= 1
        dst[unsafe_offset=i] = acc

def indexed_mm_4(
    b_div: Pointer[Float32, ImmutAnyOrigin],
    b_div_2: Pointer[Float32, ImmutAnyOrigin],
    dst: Pointer[Float32, MutAnyOrigin],
):
    var i = Int(block_idx.x * block_dim.x + thread_idx.x)
    if i < 9:
        var acc = b_div[unsafe_offset=(i // 3) * 4 + 3] * b_div_2[unsafe_offset=3 * 3 + i % 3]
        var j = Int(4) - 2
        while j >= 0:
            acc = b_div[unsafe_offset=(i // 3) * 4 + j] * b_div_2[unsafe_offset=j * 3 + i % 3] + acc
            j -= 1
        dst[unsafe_offset=i] = acc

def stage0(
    b_l: Pointer[Float32, ImmutAnyOrigin],
    b_l_2: Pointer[Float32, ImmutAnyOrigin],
    b_div: Pointer[Float32, MutAnyOrigin],
    b_div_2: Pointer[Float32, MutAnyOrigin],
    n: Int32,
):
    """Stage 0: %div, %div_2 fused, one thread per element."""
    var i = Int(block_idx.x * block_dim.x + thread_idx.x)
    if i < Int(n):
        var v_l = b_l[unsafe_offset=i]
        var v_l_2 = b_l_2[unsafe_offset=i]
        var v_div = v_l / Float32(4.0)
        var v_div_2 = v_l_2 / Float32(8.0)
        b_div[unsafe_offset=i] = v_div
        b_div_2[unsafe_offset=i] = v_div_2


@export("xir_init")
def xir_init() abi("C") -> Int32:
    """Initializes the Mojo runtime; 1 when this build targets a GPU, else 0."""
    initialize_runtime()
    comptime if has_accelerator():
        return 1
    else:
        return 0


@export("xir_device_info")
def xir_device_info(buf: Pointer[UInt8, MutAnyOrigin], cap: Int64) abi("C") -> Int64:
    """Writes `api=...;name=...` for the device the kernels run on; its length, or -1."""
    initialize_runtime()
    try:
        var ctx = DeviceContext()
        var s = String("api=", ctx.api(), ";name=", ctx.name())
        var bytes = s.as_bytes()
        var n = min(len(bytes), Int(cap))
        for i in range(n):
            buf[unsafe_offset=i] = bytes[i]
        return Int64(n)
    except e:
        return -1


@export("xir_run")
def xir_run(
    inputs: Pointer[Pointer[UInt8, ImmutAnyOrigin], ImmutAnyOrigin],
    outputs: Pointer[Pointer[UInt8, MutAnyOrigin], ImmutAnyOrigin],
) abi("C") -> Int32:
    """Runs the program: inputs[k] as the ABI lists them (the program's
    inputs, then the uploaded constants), outputs[j] in output order, every
    array as Float64, Int64 or Int32 Bool items on the host, converted
    to the scheduled device width here.

    Returns 0 when done, 1 when the device failed.
    """
    initialize_runtime()
    try:
        var ctx = DeviceContext()
        var h_a = ctx.enqueue_create_host_buffer[DType.int64](12)
        for i in range(12):
            h_a[i] = Int64(inputs[unsafe_offset=0].bitcast[Int64]()[unsafe_offset=i])
        var h_b = ctx.enqueue_create_host_buffer[DType.int64](8)
        for i in range(8):
            h_b[i] = Int64(inputs[unsafe_offset=1].bitcast[Int64]()[unsafe_offset=i])
        var h_b_2 = ctx.enqueue_create_host_buffer[DType.int64](4)
        for i in range(4):
            h_b_2[i] = Int64(inputs[unsafe_offset=2].bitcast[Int64]()[unsafe_offset=i])
        var h_a_2 = ctx.enqueue_create_host_buffer[DType.int64](3)
        for i in range(3):
            h_a_2[i] = Int64(inputs[unsafe_offset=3].bitcast[Int64]()[unsafe_offset=i])
        var h_l = ctx.enqueue_create_host_buffer[DType.float32](12)
        for i in range(12):
            h_l[i] = Float32(inputs[unsafe_offset=4].bitcast[Float64]()[unsafe_offset=i])
        var h_l_2 = ctx.enqueue_create_host_buffer[DType.float32](12)
        for i in range(12):
            h_l_2[i] = Float32(inputs[unsafe_offset=5].bitcast[Float64]()[unsafe_offset=i])
        # device buffers, one per materialized value
        var b_a = ctx.enqueue_create_buffer[DType.int64](12)
        ctx.enqueue_copy(dst_buf=b_a, src_buf=h_a)
        var b_b = ctx.enqueue_create_buffer[DType.int64](8)
        ctx.enqueue_copy(dst_buf=b_b, src_buf=h_b)
        var b_mm = ctx.enqueue_create_buffer[DType.int64](6)
        var b_b_2 = ctx.enqueue_create_buffer[DType.int64](4)
        ctx.enqueue_copy(dst_buf=b_b_2, src_buf=h_b_2)
        var b_mm_2 = ctx.enqueue_create_buffer[DType.int64](3)
        var b_a_2 = ctx.enqueue_create_buffer[DType.int64](3)
        ctx.enqueue_copy(dst_buf=b_a_2, src_buf=h_a_2)
        var b_mm_3 = ctx.enqueue_create_buffer[DType.int64](4)
        var b_l = ctx.enqueue_create_buffer[DType.float32](12)
        ctx.enqueue_copy(dst_buf=b_l, src_buf=h_l)
        var b_div = ctx.enqueue_create_buffer[DType.float32](12)
        var b_l_2 = ctx.enqueue_create_buffer[DType.float32](12)
        ctx.enqueue_copy(dst_buf=b_l_2, src_buf=h_l_2)
        var b_div_2 = ctx.enqueue_create_buffer[DType.float32](12)
        var b_mm_4 = ctx.enqueue_create_buffer[DType.float32](9)
        ctx.enqueue_function[indexed_mm](b_a, b_b, b_mm, grid_dim=1, block_dim=TPB)
        ctx.enqueue_function[indexed_mm_2](b_a, b_b_2, b_mm_2, grid_dim=1, block_dim=TPB)
        ctx.enqueue_function[indexed_mm_3](b_a, b_a_2, b_mm_3, grid_dim=1, block_dim=TPB)
        # stage 0: 12 element(s), 1 block(s) of TPB
        ctx.enqueue_function[stage0](b_l, b_l_2, b_div, b_div_2, Int32(12), grid_dim=1, block_dim=TPB)
        ctx.enqueue_function[indexed_mm_4](b_div, b_div_2, b_mm_4, grid_dim=1, block_dim=TPB)
        # the outputs, back to the host
        var o_0 = ctx.enqueue_create_host_buffer[DType.int64](6)
        ctx.enqueue_copy(dst_buf=o_0, src_buf=b_mm)
        var o_1 = ctx.enqueue_create_host_buffer[DType.int64](3)
        ctx.enqueue_copy(dst_buf=o_1, src_buf=b_mm_2)
        var o_2 = ctx.enqueue_create_host_buffer[DType.int64](4)
        ctx.enqueue_copy(dst_buf=o_2, src_buf=b_mm_3)
        var o_3 = ctx.enqueue_create_host_buffer[DType.float32](9)
        ctx.enqueue_copy(dst_buf=o_3, src_buf=b_mm_4)
        ctx.synchronize()
        for i in range(6):
            outputs[unsafe_offset=0].bitcast[Int64]()[unsafe_offset=i] = Int64(o_0[i])
        for i in range(3):
            outputs[unsafe_offset=1].bitcast[Int64]()[unsafe_offset=i] = Int64(o_1[i])
        for i in range(4):
            outputs[unsafe_offset=2].bitcast[Int64]()[unsafe_offset=i] = Int64(o_2[i])
        for i in range(9):
            outputs[unsafe_offset=3].bitcast[Float64]()[unsafe_offset=i] = Float64(o_3[i])
        return 0
    except e:
        print("xir_run failed:", e)
        return 1
