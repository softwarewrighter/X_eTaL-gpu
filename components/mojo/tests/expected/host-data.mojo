# host_data.mojo: generated by xetal-gpu (components/mojo) from host_data. Do not edit.
# 2 fused kernel stage(s), 1 reduction(s), 7 device buffer(s).
# 3 indexed kernel(s), one thread per result.

from std.math import exp, log, cos, sin, sqrt, floor, inf, nan
from std.memory import unsafe_stack_allocation
from std.runtime import initialize_runtime
from std.sys import has_accelerator

from max.gpu import block_dim, block_idx, thread_idx
from max.gpu.host import DeviceContext
from max.gpu.sync import barrier

comptime TPB = 256

def reduce_add_int64(
    src: Pointer[Int64, ImmutAnyOrigin],
    dst: Pointer[Int64, MutAnyOrigin],
    n: Int32,
):
    """One block folds TPB items of src into dst[block]: a tree in shared memory."""
    var shared = unsafe_stack_allocation[TPB, Int64, address_space=.SHARED]()
    var tid = Int(thread_idx.x)
    var i = Int(block_idx.x) * TPB + tid
    var v: Int64 = Int64(0)
    if i < Int(n):
        v = src[unsafe_offset=i]
    shared[unsafe_offset=tid] = v
    barrier()
    var active = TPB // 2
    while active > 0:
        if tid < active:
            var lhs = shared[unsafe_offset=tid]
            var rhs = shared[unsafe_offset=tid + active]
            shared[unsafe_offset=tid] = lhs + rhs
        barrier()
        active //= 2
    if tid == 0:
        dst[unsafe_offset=Int(block_idx.x)] = shared[unsafe_offset=0][0]

def indexed_addr(
    b_m: Pointer[Int64, ImmutAnyOrigin],
    dst: Pointer[Int64, MutAnyOrigin],
):
    var i = Int(block_idx.x * block_dim.x + thread_idx.x)
    if i < 3:
        var base = (i // 1) * 3 * 1 + i % 1
        var acc = b_m[unsafe_offset=base + 2 * 1]
        var j = Int(3) - 2
        while j >= 0:
            acc = b_m[unsafe_offset=base + j * 1] + acc
            j -= 1
        dst[unsafe_offset=i] = acc

def indexed_t(
    b_m: Pointer[Int64, ImmutAnyOrigin],
    dst: Pointer[Int64, MutAnyOrigin],
):
    var i = Int(block_idx.x * block_dim.x + thread_idx.x)
    if i < 9:
        dst[unsafe_offset=i] = b_m[unsafe_offset=((i // 1) % 3) * 3 + ((i // 3) % 3) * 1]

def indexed_mm(
    b_m: Pointer[Int64, ImmutAnyOrigin],
    b_t: Pointer[Int64, ImmutAnyOrigin],
    dst: Pointer[Int64, MutAnyOrigin],
):
    var i = Int(block_idx.x * block_dim.x + thread_idx.x)
    if i < 9:
        var acc = b_m[unsafe_offset=(i // 3) * 3 + 2] * b_t[unsafe_offset=2 * 3 + i % 3]
        var j = Int(3) - 2
        while j >= 0:
            acc = b_m[unsafe_offset=(i // 3) * 3 + j] * b_t[unsafe_offset=j * 3 + i % 3] + acc
            j -= 1
        dst[unsafe_offset=i] = acc

def stage0(
    b_v: Pointer[Int64, ImmutAnyOrigin],
    b_mul: Pointer[Int64, MutAnyOrigin],
    n: Int32,
):
    """Stage 0: %mul fused, one thread per element."""
    var i = Int(block_idx.x * block_dim.x + thread_idx.x)
    if i < Int(n):
        var v_v = b_v[unsafe_offset=i]
        var v_mul = v_v * v_v
        b_mul[unsafe_offset=i] = v_mul

def stage1(
    b_v: Pointer[Int64, ImmutAnyOrigin],
    n: Int32,
):
    """Stage 1: %f, %div fused, one thread per element."""
    var i = Int(block_idx.x * block_dim.x + thread_idx.x)
    if i < Int(n):
        var v_v = b_v[unsafe_offset=i]
        var v_f = Float32(v_v)
        var v_div = v_f / Float32(2.0)


@export("xir_init")
def xir_init() abi("C") -> Int32:
    """Initializes the Mojo runtime; 1 when this build targets a GPU, else 0."""
    initialize_runtime()
    comptime if has_accelerator():
        return 1
    else:
        return 0


@export("xir_device_info")
def xir_device_info(buf: Pointer[UInt8, MutAnyOrigin], cap: Int64) abi("C") -> Int64:
    """Writes `api=...;name=...` for the device the kernels run on; its length, or -1."""
    initialize_runtime()
    try:
        var ctx = DeviceContext()
        var s = String("api=", ctx.api(), ";name=", ctx.name())
        var bytes = s.as_bytes()
        var n = min(len(bytes), Int(cap))
        for i in range(n):
            buf[unsafe_offset=i] = bytes[i]
        return Int64(n)
    except e:
        return -1


@export("xir_run")
def xir_run(
    inputs: Pointer[Pointer[UInt8, ImmutAnyOrigin], ImmutAnyOrigin],
    outputs: Pointer[Pointer[UInt8, MutAnyOrigin], ImmutAnyOrigin],
) abi("C") -> Int32:
    """Runs the program: inputs[k] as the ABI lists them (the program's
    inputs, then the uploaded constants), outputs[j] in output order, every
    array as Float64, Int64 or Int32 Bool items on the host, converted
    to the scheduled device width here.

    Returns 0 when done, 1 when the device failed.
    """
    initialize_runtime()
    try:
        var ctx = DeviceContext()
        var h_v = ctx.enqueue_create_host_buffer[DType.int64](5)
        for i in range(5):
            h_v[i] = Int64(inputs[unsafe_offset=0].bitcast[Int64]()[unsafe_offset=i])
        var h_m = ctx.enqueue_create_host_buffer[DType.int64](9)
        for i in range(9):
            h_m[i] = Int64(inputs[unsafe_offset=1].bitcast[Int64]()[unsafe_offset=i])
        # device buffers, one per materialized value
        var b_v = ctx.enqueue_create_buffer[DType.int64](5)
        ctx.enqueue_copy(dst_buf=b_v, src_buf=h_v)
        var b_m = ctx.enqueue_create_buffer[DType.int64](9)
        ctx.enqueue_copy(dst_buf=b_m, src_buf=h_m)
        var b_addr = ctx.enqueue_create_buffer[DType.int64](3)
        var b_mul = ctx.enqueue_create_buffer[DType.int64](5)
        var b_addr_2 = ctx.enqueue_create_buffer[DType.int64](1)
        var b_t = ctx.enqueue_create_buffer[DType.int64](9)
        var b_mm = ctx.enqueue_create_buffer[DType.int64](9)
        ctx.enqueue_function[indexed_addr](b_m, b_addr, grid_dim=1, block_dim=TPB)
        # stage 0: 5 element(s), 1 block(s) of TPB
        ctx.enqueue_function[stage0](b_v, b_mul, Int32(5), grid_dim=1, block_dim=TPB)
        # reduce add %mul -> %addr_2: a partial per block of 256, until one is left (1 pass(es))
        ctx.enqueue_function[reduce_add_int64](b_mul, b_addr_2, Int32(5), grid_dim=1, block_dim=TPB)
        ctx.enqueue_function[indexed_t](b_m, b_t, grid_dim=1, block_dim=TPB)
        ctx.enqueue_function[indexed_mm](b_m, b_t, b_mm, grid_dim=1, block_dim=TPB)
        # stage 1: 5 element(s), 1 block(s) of TPB
        ctx.enqueue_function[stage1](b_v, Int32(5), grid_dim=1, block_dim=TPB)
        # the outputs, back to the host
        var o_0 = ctx.enqueue_create_host_buffer[DType.int64](3)
        ctx.enqueue_copy(dst_buf=o_0, src_buf=b_addr)
        var o_1 = ctx.enqueue_create_host_buffer[DType.int64](1)
        ctx.enqueue_copy(dst_buf=o_1, src_buf=b_addr_2)
        var o_2 = ctx.enqueue_create_host_buffer[DType.int64](9)
        ctx.enqueue_copy(dst_buf=o_2, src_buf=b_mm)
        ctx.synchronize()
        for i in range(3):
            outputs[unsafe_offset=0].bitcast[Int64]()[unsafe_offset=i] = Int64(o_0[i])
        for i in range(1):
            outputs[unsafe_offset=1].bitcast[Int64]()[unsafe_offset=i] = Int64(o_1[i])
        for i in range(9):
            outputs[unsafe_offset=2].bitcast[Int64]()[unsafe_offset=i] = Int64(o_2[i])
        return 0
    except e:
        print("xir_run failed:", e)
        return 1
