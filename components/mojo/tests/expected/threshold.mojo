# 1 fused kernel stage(s), 0 reduction(s), 7 device buffer(s).

from std.math import exp, log, cos, sin, sqrt, floor, inf, nan
from std.memory import unsafe_stack_allocation
from std.runtime import initialize_runtime
from std.sys import has_accelerator

from max.gpu import block_dim, block_idx, thread_idx
from max.gpu.host import DeviceContext
from max.gpu.sync import barrier

comptime TPB = 256

def stage0(
    b_l: Pointer[Float32, ImmutAnyOrigin],
    b_l_2: Pointer[Int64, ImmutAnyOrigin],
    b_sub: Pointer[Float32, MutAnyOrigin],
    b_mul: Pointer[Float32, MutAnyOrigin],
    b_max: Pointer[Float32, MutAnyOrigin],
    b_max_2: Pointer[Int64, MutAnyOrigin],
    b_mul_2: Pointer[Int64, MutAnyOrigin],
    n: Int32,
):
    """Stage 0: %div, %sub, %gt, %f, %mul, %max, %sub_2, %max_2, %mod, %mul_2 fused, one thread per element."""
    var i = Int(block_idx.x * block_dim.x + thread_idx.x)
    if i < Int(n):
        var v_l = b_l[unsafe_offset=i]
        var v_l_2 = b_l_2[unsafe_offset=i]
        var v_div = v_l / Float32(4.0)
        var v_sub = v_div - Float32(1.0)
        var v_gt = Bool(v_sub > Float32(0.5))
        var v_f = Float32(1) if v_gt else Float32(0)
        var v_mul = v_sub * v_f
        var v_max = max(v_sub, Float32(0.0))
        var v_sub_2 = v_l_2 - Int64(4)
        var v_max_2 = max(v_sub_2, Int64(0))
        var v_mod = v_sub_2 % Int64(2)
        var v_mul_2 = v_sub_2 * v_mod
        b_sub[unsafe_offset=i] = v_sub
        b_mul[unsafe_offset=i] = v_mul
        b_max[unsafe_offset=i] = v_max
        b_max_2[unsafe_offset=i] = v_max_2
        b_mul_2[unsafe_offset=i] = v_mul_2


@export("xir_init")
def xir_init() abi("C") -> Int32:
    """Initializes the Mojo runtime; 1 when this build targets a GPU, else 0."""
    initialize_runtime()
    comptime if has_accelerator():
        return 1
    else:
        return 0


@export("xir_device_info")
def xir_device_info(buf: Pointer[UInt8, MutAnyOrigin], cap: Int64) abi("C") -> Int64:
    """Writes `api=...;name=...` for the device the kernels run on; its length, or -1."""
    initialize_runtime()
    try:
        var ctx = DeviceContext()
        var s = String("api=", ctx.api(), ";name=", ctx.name())
        var bytes = s.as_bytes()
        var n = min(len(bytes), Int(cap))
        for i in range(n):
            buf[unsafe_offset=i] = bytes[i]
        return Int64(n)
    except e:
        return -1


@export("xir_run")
def xir_run(
    inputs: Pointer[Pointer[UInt8, ImmutAnyOrigin], ImmutAnyOrigin],
    outputs: Pointer[Pointer[UInt8, MutAnyOrigin], ImmutAnyOrigin],
) abi("C") -> Int32:
    """Runs the program: inputs[k] as the ABI lists them (the program's
    inputs, then the uploaded constants), outputs[j] in output order, every
    array as Float64, Int64 or Int32 Bool items on the host, converted
    to the scheduled device width here.

    Returns 0 when done, 1 when the device failed.
    """
    initialize_runtime()
    try:
        var ctx = DeviceContext()
        var h_l = ctx.enqueue_create_host_buffer[DType.float32](8)
        for i in range(8):
            h_l[i] = Float32(inputs[unsafe_offset=0].bitcast[Float64]()[unsafe_offset=i])
        var h_l_2 = ctx.enqueue_create_host_buffer[DType.int64](8)
        for i in range(8):
            h_l_2[i] = Int64(inputs[unsafe_offset=1].bitcast[Int64]()[unsafe_offset=i])
        # device buffers, one per materialized value
        var b_l = ctx.enqueue_create_buffer[DType.float32](8)
        ctx.enqueue_copy(dst_buf=b_l, src_buf=h_l)
        var b_sub = ctx.enqueue_create_buffer[DType.float32](8)
        var b_mul = ctx.enqueue_create_buffer[DType.float32](8)
        var b_max = ctx.enqueue_create_buffer[DType.float32](8)
        var b_l_2 = ctx.enqueue_create_buffer[DType.int64](8)
        ctx.enqueue_copy(dst_buf=b_l_2, src_buf=h_l_2)
        var b_max_2 = ctx.enqueue_create_buffer[DType.int64](8)
        var b_mul_2 = ctx.enqueue_create_buffer[DType.int64](8)
        # stage 0: 8 element(s), 1 block(s) of TPB
        ctx.enqueue_function[stage0](b_l, b_l_2, b_sub, b_mul, b_max, b_max_2, b_mul_2, Int32(8), grid_dim=1, block_dim=TPB)
        # the outputs, back to the host
        var o_0 = ctx.enqueue_create_host_buffer[DType.float32](8)
        ctx.enqueue_copy(dst_buf=o_0, src_buf=b_sub)
        var o_1 = ctx.enqueue_create_host_buffer[DType.float32](8)
        ctx.enqueue_copy(dst_buf=o_1, src_buf=b_mul)
        var o_2 = ctx.enqueue_create_host_buffer[DType.float32](8)
        ctx.enqueue_copy(dst_buf=o_2, src_buf=b_max)
        var o_3 = ctx.enqueue_create_host_buffer[DType.int64](8)
        ctx.enqueue_copy(dst_buf=o_3, src_buf=b_max_2)
        var o_4 = ctx.enqueue_create_host_buffer[DType.int64](8)
        ctx.enqueue_copy(dst_buf=o_4, src_buf=b_mul_2)
        ctx.synchronize()
        for i in range(8):
            outputs[unsafe_offset=0].bitcast[Float64]()[unsafe_offset=i] = Float64(o_0[i])
        for i in range(8):
            outputs[unsafe_offset=1].bitcast[Float64]()[unsafe_offset=i] = Float64(o_1[i])
        for i in range(8):
            outputs[unsafe_offset=2].bitcast[Float64]()[unsafe_offset=i] = Float64(o_2[i])
        for i in range(8):
            outputs[unsafe_offset=3].bitcast[Int64]()[unsafe_offset=i] = Int64(o_3[i])
        for i in range(8):
            outputs[unsafe_offset=4].bitcast[Int64]()[unsafe_offset=i] = Int64(o_4[i])
        return 0
    except e:
        print("xir_run failed:", e)
        return 1
