    b_tb_13: Pointer[Float32, ImmutAnyOrigin],
    b_f_11: Pointer[Float32, MutAnyOrigin],
    n: Int32,
):
    """Stage 14: %eq_8, %f_10, %mul_10, %sub_13, %sub_14, %gt_3, %f_11 fused, one thread per element."""
    var i = Int(block_idx.x * block_dim.x + thread_idx.x)
