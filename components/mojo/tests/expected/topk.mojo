def stage18(
    b_s: Pointer[Float32, ImmutAnyOrigin],
    b_tb_14: Pointer[Float32, ImmutAnyOrigin],
    b_sub_17: Pointer[Float32, ImmutAnyOrigin],
    b_tb_17: Pointer[Float32, ImmutAnyOrigin],
    b_mul_14: Pointer[Float32, MutAnyOrigin],
    n: Int32,
):
    """Stage 18: %eq_11, %f_14, %mul_13, %sub_18, %sub_19, %gt_4, %f_15, %mul_14 fused, one thread per element."""
    var i = Int(block_idx.x * block_dim.x + thread_idx.x)
