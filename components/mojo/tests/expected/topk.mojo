@export("xir_init")
def xir_init() abi("C") -> Int32:
    """Initializes the Mojo runtime; 1 when this build targets a GPU, else 0."""
    initialize_runtime()
    comptime if has_accelerator():
        return 1
    else:
        return 0


@export("xir_device_info")
def xir_device_info(buf: Pointer[UInt8, MutAnyOrigin], cap: Int64) abi("C") -> Int64:
    """Writes `api=...;name=...` for the device the kernels run on; its length, or -1."""
    initialize_runtime()
    try:
        var ctx = DeviceContext()
        var s = String("api=", ctx.api(), ";name=", ctx.name())
        var bytes = s.as_bytes()
        var n = min(len(bytes), Int(cap))
        for i in range(n):
            buf[unsafe_offset=i] = bytes[i]
        return Int64(n)
    except e:
        return -1


@export("xir_run")
def xir_run(
    inputs: Pointer[Pointer[UInt8, ImmutAnyOrigin], ImmutAnyOrigin],
    outputs: Pointer[Pointer[UInt8, MutAnyOrigin], ImmutAnyOrigin],
) abi("C") -> Int32:
    """Runs the program: inputs[k] as the ABI lists them (the program's
    inputs, then the uploaded constants), outputs[j] in output order, every
    array as Float64, Int64 or Int32 Bool items on the host, converted
    to the scheduled device width here.

    Returns 0 when done, 1 when the device failed.
    """
    initialize_runtime()
    try:
        var ctx = DeviceContext()
        var h_m = ctx.enqueue_create_host_buffer[DType.float32](12)
        for i in range(12):
            h_m[i] = Float32(inputs[unsafe_offset=0].bitcast[Float64]()[unsafe_offset=i])
        var h_b = ctx.enqueue_create_host_buffer[DType.int64](4)
        for i in range(4):
            h_b[i] = Int64(inputs[unsafe_offset=1].bitcast[Int64]()[unsafe_offset=i])
        var h_a = ctx.enqueue_create_host_buffer[DType.int64](3)
        for i in range(3):
            h_a[i] = Int64(inputs[unsafe_offset=2].bitcast[Int64]()[unsafe_offset=i])
        var h_b_2 = ctx.enqueue_create_host_buffer[DType.float32](4)
        for i in range(4):
            h_b_2[i] = Float32(inputs[unsafe_offset=3].bitcast[Float64]()[unsafe_offset=i])
        var h_b_3 = ctx.enqueue_create_host_buffer[DType.int64](4)
        for i in range(4):
            h_b_3[i] = Int64(inputs[unsafe_offset=4].bitcast[Int64]()[unsafe_offset=i])
        var h_b_4 = ctx.enqueue_create_host_buffer[DType.int64](4)
        for i in range(4):
            h_b_4[i] = Int64(inputs[unsafe_offset=5].bitcast[Int64]()[unsafe_offset=i])
        var h_b_5 = ctx.enqueue_create_host_buffer[DType.int64](4)
        for i in range(4):
            h_b_5[i] = Int64(inputs[unsafe_offset=6].bitcast[Int64]()[unsafe_offset=i])
        var h_b_6 = ctx.enqueue_create_host_buffer[DType.int64](4)
        for i in range(4):
            h_b_6[i] = Int64(inputs[unsafe_offset=7].bitcast[Int64]()[unsafe_offset=i])
        var h_b_7 = ctx.enqueue_create_host_buffer[DType.int64](4)
        for i in range(4):
            h_b_7[i] = Int64(inputs[unsafe_offset=8].bitcast[Int64]()[unsafe_offset=i])
        var h_s = ctx.enqueue_create_host_buffer[DType.float32](20)
        for i in range(20):
            h_s[i] = Float32(inputs[unsafe_offset=9].bitcast[Float64]()[unsafe_offset=i])
        var h_b_8 = ctx.enqueue_create_host_buffer[DType.int64](5)
        for i in range(5):
            h_b_8[i] = Int64(inputs[unsafe_offset=10].bitcast[Int64]()[unsafe_offset=i])
        var h_a_2 = ctx.enqueue_create_host_buffer[DType.int64](4)
        for i in range(4):
            h_a_2[i] = Int64(inputs[unsafe_offset=11].bitcast[Int64]()[unsafe_offset=i])
        var h_b_9 = ctx.enqueue_create_host_buffer[DType.float32](5)
        for i in range(5):
            h_b_9[i] = Float32(inputs[unsafe_offset=12].bitcast[Float64]()[unsafe_offset=i])
        var h_b_10 = ctx.enqueue_create_host_buffer[DType.int64](5)
        for i in range(5):
            h_b_10[i] = Int64(inputs[unsafe_offset=13].bitcast[Int64]()[unsafe_offset=i])
        var h_b_11 = ctx.enqueue_create_host_buffer[DType.int64](5)
        for i in range(5):
            h_b_11[i] = Int64(inputs[unsafe_offset=14].bitcast[Int64]()[unsafe_offset=i])
        var h_b_12 = ctx.enqueue_create_host_buffer[DType.int64](5)
        for i in range(5):
            h_b_12[i] = Int64(inputs[unsafe_offset=15].bitcast[Int64]()[unsafe_offset=i])
        var h_b_13 = ctx.enqueue_create_host_buffer[DType.int64](5)
        for i in range(5):
            h_b_13[i] = Int64(inputs[unsafe_offset=16].bitcast[Int64]()[unsafe_offset=i])
        var h_b_14 = ctx.enqueue_create_host_buffer[DType.int64](5)
        for i in range(5):
            h_b_14[i] = Int64(inputs[unsafe_offset=17].bitcast[Int64]()[unsafe_offset=i])
        var h_b_15 = ctx.enqueue_create_host_buffer[DType.int64](5)
        for i in range(5):
            h_b_15[i] = Int64(inputs[unsafe_offset=18].bitcast[Int64]()[unsafe_offset=i])
        var h_b_16 = ctx.enqueue_create_host_buffer[DType.int64](5)
        for i in range(5):
            h_b_16[i] = Int64(inputs[unsafe_offset=19].bitcast[Int64]()[unsafe_offset=i])
        var h_b_17 = ctx.enqueue_create_host_buffer[DType.int64](5)
        for i in range(5):
            h_b_17[i] = Int64(inputs[unsafe_offset=20].bitcast[Int64]()[unsafe_offset=i])
        # device buffers, one per materialized value
        var b_m = ctx.enqueue_create_buffer[DType.float32](12)
        ctx.enqueue_copy(dst_buf=b_m, src_buf=h_m)
        var b_maxr = ctx.enqueue_create_buffer[DType.float32](3)
        var b_b = ctx.enqueue_create_buffer[DType.int64](4)
        ctx.enqueue_copy(dst_buf=b_b, src_buf=h_b)
        var b_tb = ctx.enqueue_create_buffer[DType.float32](12)
        var b_f = ctx.enqueue_create_buffer[DType.float32](12)
        var b_mul = ctx.enqueue_create_buffer[DType.float32](12)
        var b_a = ctx.enqueue_create_buffer[DType.int64](3)
        ctx.enqueue_copy(dst_buf=b_a, src_buf=h_a)
        var b_b_2 = ctx.enqueue_create_buffer[DType.float32](4)
        ctx.enqueue_copy(dst_buf=b_b_2, src_buf=h_b_2)
        var b_tb_2 = ctx.enqueue_create_buffer[DType.float32](12)
        var b_add = ctx.enqueue_create_buffer[DType.float32](12)
        var b_minr = ctx.enqueue_create_buffer[DType.float32](3)
        var b_fl = ctx.enqueue_create_buffer[DType.int64](3)
        var b_minr_2 = ctx.enqueue_create_buffer[DType.float32](3)
        var b_maxr_2 = ctx.enqueue_create_buffer[DType.float32](3)
        var b_add_2 = ctx.enqueue_create_buffer[DType.float32](3)
        var b_b_3 = ctx.enqueue_create_buffer[DType.int64](4)
        ctx.enqueue_copy(dst_buf=b_b_3, src_buf=h_b_3)
        var b_tb_3 = ctx.enqueue_create_buffer[DType.float32](12)
        var b_maxr_3 = ctx.enqueue_create_buffer[DType.float32](3)
        var b_b_4 = ctx.enqueue_create_buffer[DType.int64](4)
        ctx.enqueue_copy(dst_buf=b_b_4, src_buf=h_b_4)
        var b_tb_4 = ctx.enqueue_create_buffer[DType.float32](12)
        var b_sub_3 = ctx.enqueue_create_buffer[DType.float32](12)
        var b_maxr_4 = ctx.enqueue_create_buffer[DType.float32](3)
        var b_b_5 = ctx.enqueue_create_buffer[DType.int64](4)
        ctx.enqueue_copy(dst_buf=b_b_5, src_buf=h_b_5)
        var b_tb_5 = ctx.enqueue_create_buffer[DType.float32](12)
        var b_f_4 = ctx.enqueue_create_buffer[DType.float32](12)
        var b_minr_3 = ctx.enqueue_create_buffer[DType.float32](3)
        var b_maxr_5 = ctx.enqueue_create_buffer[DType.float32](3)
        var b_add_3 = ctx.enqueue_create_buffer[DType.float32](3)
        var b_b_6 = ctx.enqueue_create_buffer[DType.int64](4)
        ctx.enqueue_copy(dst_buf=b_b_6, src_buf=h_b_6)
        var b_tb_6 = ctx.enqueue_create_buffer[DType.float32](12)
        var b_maxr_6 = ctx.enqueue_create_buffer[DType.float32](3)
        var b_b_7 = ctx.enqueue_create_buffer[DType.int64](4)
        ctx.enqueue_copy(dst_buf=b_b_7, src_buf=h_b_7)
        var b_tb_7 = ctx.enqueue_create_buffer[DType.float32](12)
        var b_f_6 = ctx.enqueue_create_buffer[DType.float32](12)
        var b_s = ctx.enqueue_create_buffer[DType.float32](20)
        ctx.enqueue_copy(dst_buf=b_s, src_buf=h_s)
        var b_maxr_7 = ctx.enqueue_create_buffer[DType.float32](4)
        var b_b_8 = ctx.enqueue_create_buffer[DType.int64](5)
        ctx.enqueue_copy(dst_buf=b_b_8, src_buf=h_b_8)
        var b_tb_8 = ctx.enqueue_create_buffer[DType.float32](20)
        var b_f_7 = ctx.enqueue_create_buffer[DType.float32](20)
        var b_mul_6 = ctx.enqueue_create_buffer[DType.float32](20)
        var b_a_2 = ctx.enqueue_create_buffer[DType.int64](4)
        ctx.enqueue_copy(dst_buf=b_a_2, src_buf=h_a_2)
        var b_b_9 = ctx.enqueue_create_buffer[DType.float32](5)
        ctx.enqueue_copy(dst_buf=b_b_9, src_buf=h_b_9)
        var b_tb_9 = ctx.enqueue_create_buffer[DType.float32](20)
        var b_add_4 = ctx.enqueue_create_buffer[DType.float32](20)
        var b_minr_4 = ctx.enqueue_create_buffer[DType.float32](4)
        var b_fl_2 = ctx.enqueue_create_buffer[DType.int64](4)
        var b_minr_5 = ctx.enqueue_create_buffer[DType.float32](4)
        var b_maxr_8 = ctx.enqueue_create_buffer[DType.float32](4)
        var b_add_5 = ctx.enqueue_create_buffer[DType.float32](4)
        var b_b_10 = ctx.enqueue_create_buffer[DType.int64](5)
        ctx.enqueue_copy(dst_buf=b_b_10, src_buf=h_b_10)
        var b_tb_10 = ctx.enqueue_create_buffer[DType.float32](20)
        var b_maxr_9 = ctx.enqueue_create_buffer[DType.float32](4)
        var b_b_11 = ctx.enqueue_create_buffer[DType.int64](5)
        ctx.enqueue_copy(dst_buf=b_b_11, src_buf=h_b_11)
