        var b_sub_11 = ctx.enqueue_create_buffer[DType.float32](20)
        var b_maxr_10 = ctx.enqueue_create_buffer[DType.float32](4)
        var b_b_12 = ctx.enqueue_create_buffer[DType.int64](5)
        ctx.enqueue_copy(dst_buf=b_b_12, src_buf=h_b_12)
