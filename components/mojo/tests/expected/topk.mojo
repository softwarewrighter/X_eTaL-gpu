        var v_tb_9 = b_tb_9[unsafe_offset=i]
        var v_mul_7 = v_f_7 * v_tb_9
        var v_add_4 = v_mul_7 + v_mul_6
        b_add_4[unsafe_offset=i] = v_add_4

def stage10(
