    """Stage 7: %eq_4, %f_5, %mul_5, %sub_7, %sub_8, %gt_2, %f_6 fused, one thread per element."""
    var i = Int(block_idx.x * block_dim.x + thread_idx.x)
    if i < Int(n):
        var v_m = b_m[unsafe_offset=i]
        var v_tb_6 = b_tb_6[unsafe_offset=i]
        var v_tb_7 = b_tb_7[unsafe_offset=i]
        var v_eq_4 = Bool(v_m == v_tb_7)
        var v_f_5 = Float32(1) if v_eq_4 else Float32(0)
        var v_mul_5 = v_tb_6 * v_f_5
        var v_sub_7 = v_m - v_mul_5
        var v_sub_8 = v_m - v_sub_7
        var v_gt_2 = Bool(v_sub_8 > Float32(0.0))
        var v_f_6 = Float32(1) if v_gt_2 else Float32(0)
        b_f_6[unsafe_offset=i] = v_f_6

def stage8(
    b_s: Pointer[Float32, ImmutAnyOrigin],
    b_tb_8: Pointer[Float32, ImmutAnyOrigin],
    b_f_7: Pointer[Float32, MutAnyOrigin],
    b_mul_6: Pointer[Float32, MutAnyOrigin],
    n: Int32,
):
    """Stage 8: %eq_5, %f_7, %sub_9, %mul_6 fused, one thread per element."""
    var i = Int(block_idx.x * block_dim.x + thread_idx.x)
    if i < Int(n):
        var v_s = b_s[unsafe_offset=i]
        var v_tb_8 = b_tb_8[unsafe_offset=i]
        var v_eq_5 = Bool(v_s == v_tb_8)
        var v_f_7 = Float32(1) if v_eq_5 else Float32(0)
        var v_sub_9 = Float32(1.0) - v_f_7
        var v_mul_6 = v_sub_9 * Float32(6.0)
        b_f_7[unsafe_offset=i] = v_f_7
        b_mul_6[unsafe_offset=i] = v_mul_6

def stage9(
    b_f_7: Pointer[Float32, ImmutAnyOrigin],
    b_mul_6: Pointer[Float32, ImmutAnyOrigin],
