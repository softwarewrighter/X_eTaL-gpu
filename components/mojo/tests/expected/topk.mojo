        var v_sub_12 = v_sub_11 - v_mul_9
        b_sub_12[unsafe_offset=i] = v_sub_12

def stage14(
    b_s: Pointer[Float32, ImmutAnyOrigin],
    b_tb_10: Pointer[Float32, ImmutAnyOrigin],
