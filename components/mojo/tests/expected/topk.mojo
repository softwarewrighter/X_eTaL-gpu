def stage17(
    b_tb_14: Pointer[Float32, ImmutAnyOrigin],
    b_sub_16: Pointer[Float32, ImmutAnyOrigin],
    b_tb_16: Pointer[Float32, ImmutAnyOrigin],
    b_sub_17: Pointer[Float32, MutAnyOrigin],
