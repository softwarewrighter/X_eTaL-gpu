        var v_tb_13 = b_tb_13[unsafe_offset=i]
        var v_eq_8 = Bool(v_sub_12 == v_tb_13)
        var v_f_10 = Float32(1) if v_eq_8 else Float32(0)
        var v_mul_10 = v_tb_10 * v_f_10
        var v_sub_13 = v_sub_12 - v_mul_10
        var v_sub_14 = v_s - v_sub_13
        var v_gt_3 = Bool(v_sub_14 > Float32(0.0))
        var v_f_11 = Float32(1) if v_gt_3 else Float32(0)
        b_f_11[unsafe_offset=i] = v_f_11

def stage15(
