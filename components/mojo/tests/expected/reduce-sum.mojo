def reduce_max_int64(
    src: Pointer[Int64, ImmutAnyOrigin],
    dst: Pointer[Int64, MutAnyOrigin],
    n: Int32,
):
    """One block folds TPB items of src into dst[block]: a tree in shared memory."""
    var shared = unsafe_stack_allocation[TPB, Int64, address_space=.SHARED]()
    var tid = Int(thread_idx.x)
    var i = Int(block_idx.x) * TPB + tid
    var v: Int64 = src[unsafe_offset=0]
    if i < Int(n):
        v = src[unsafe_offset=i]
    shared[unsafe_offset=tid] = v
    barrier()
    var active = TPB // 2
    while active > 0:
        if tid < active:
            var lhs = shared[unsafe_offset=tid]
            var rhs = shared[unsafe_offset=tid + active]
            shared[unsafe_offset=tid] = max(lhs, rhs)
        barrier()
        active //= 2
    if tid == 0:
        dst[unsafe_offset=Int(block_idx.x)] = shared[unsafe_offset=0][0]

def stage0(
    b_a: Pointer[Int64, ImmutAnyOrigin],
    b_mul: Pointer[Int64, MutAnyOrigin],
    b_add: Pointer[Int64, MutAnyOrigin],
    n: Int32,
):
    """Stage 0: %mul, %add fused, one thread per element."""
    var i = Int(block_idx.x * block_dim.x + thread_idx.x)
    if i < Int(n):
        var v_a = b_a[unsafe_offset=i]
        var v_mul = Int64(2) * v_a
        var v_add = v_a + v_mul
        b_mul[unsafe_offset=i] = v_mul
        b_add[unsafe_offset=i] = v_add

def stage1(
    b_a: Pointer[Int64, ImmutAnyOrigin],
    b_mul: Pointer[Int64, ImmutAnyOrigin],
    b_mul_2: Pointer[Int64, MutAnyOrigin],
    n: Int32,
):
    """Stage 1: %mul_2 fused, one thread per element."""
    var i = Int(block_idx.x * block_dim.x + thread_idx.x)
    if i < Int(n):
        var v_a = b_a[unsafe_offset=i]
        var v_mul = b_mul[unsafe_offset=i]
        var v_mul_2 = v_a * v_mul
        b_mul_2[unsafe_offset=i] = v_mul_2

def stage2(
    b_l_2: Pointer[Float32, ImmutAnyOrigin],
    b_div: Pointer[Float32, MutAnyOrigin],
    n: Int32,
):
    """Stage 2: %div fused, one thread per element."""
    var i = Int(block_idx.x * block_dim.x + thread_idx.x)
    if i < Int(n):
        var v_l_2 = b_l_2[unsafe_offset=i]
        var v_div = v_l_2 / Float32(8.0)
        b_div[unsafe_offset=i] = v_div

def stage3(
    b_div: Pointer[Float32, ImmutAnyOrigin],
    b_mul_3: Pointer[Float32, MutAnyOrigin],
    n: Int32,
):
    """Stage 3: %mul_3 fused, one thread per element."""
    var i = Int(block_idx.x * block_dim.x + thread_idx.x)
    if i < Int(n):
        var v_div = b_div[unsafe_offset=i]
        var v_mul_3 = v_div * v_div
        b_mul_3[unsafe_offset=i] = v_mul_3


@export("xir_init")
def xir_init() abi("C") -> Int32:
    """Initializes the Mojo runtime; 1 when this build targets a GPU, else 0."""
    initialize_runtime()
    comptime if has_accelerator():
        return 1
    else:
        return 0


@export("xir_device_info")
def xir_device_info(buf: Pointer[UInt8, MutAnyOrigin], cap: Int64) abi("C") -> Int64:
    """Writes `api=...;name=...` for the device the kernels run on; its length, or -1."""
    initialize_runtime()
    try:
        var ctx = DeviceContext()
        var s = String("api=", ctx.api(), ";name=", ctx.name())
        var bytes = s.as_bytes()
        var n = min(len(bytes), Int(cap))
        for i in range(n):
            buf[unsafe_offset=i] = bytes[i]
        return Int64(n)
    except e:
        return -1


@export("xir_run")
def xir_run(
    inputs: Pointer[Pointer[Float64, ImmutAnyOrigin], ImmutAnyOrigin],
    outputs: Pointer[Pointer[Float64, MutAnyOrigin], ImmutAnyOrigin],
) abi("C") -> Int32:
    """Runs the program: inputs[k] as the ABI lists them (the program's
    inputs, then the uploaded constants), outputs[j] in output order, every
    array as Float64 items on the host (converted to the device's width here).

    Returns 0 when done, 1 when the device failed.
    """
    initialize_runtime()
    try:
        var ctx = DeviceContext()
        var h_a = ctx.enqueue_create_host_buffer[DType.int64](8)
        for i in range(8):
            h_a[i] = Int64(inputs[unsafe_offset=0][unsafe_offset=i])
        var h_l_2 = ctx.enqueue_create_host_buffer[DType.float32](8)
        for i in range(8):
            h_l_2[i] = Float32(inputs[unsafe_offset=1][unsafe_offset=i])
        # device buffers, one per materialized value
        var b_a = ctx.enqueue_create_buffer[DType.int64](8)
        ctx.enqueue_copy(dst_buf=b_a, src_buf=h_a)
        var b_mul = ctx.enqueue_create_buffer[DType.int64](8)
        var b_add = ctx.enqueue_create_buffer[DType.int64](8)
        var b_addr = ctx.enqueue_create_buffer[DType.int64](1)
        var b_maxr = ctx.enqueue_create_buffer[DType.int64](1)
        var b_mul_2 = ctx.enqueue_create_buffer[DType.int64](8)
        var b_addr_2 = ctx.enqueue_create_buffer[DType.int64](1)
        var b_l_2 = ctx.enqueue_create_buffer[DType.float32](8)
        ctx.enqueue_copy(dst_buf=b_l_2, src_buf=h_l_2)
        var b_div = ctx.enqueue_create_buffer[DType.float32](8)
        var b_addr_3 = ctx.enqueue_create_buffer[DType.float32](1)
        var b_mul_3 = ctx.enqueue_create_buffer[DType.float32](8)
        var b_addr_4 = ctx.enqueue_create_buffer[DType.float32](1)
        # stage 0: 8 element(s), 1 block(s) of TPB
        ctx.enqueue_function[stage0](b_a, b_mul, b_add, Int32(8), grid_dim=1, block_dim=TPB)
        # reduce add %add -> %addr: a partial per block of 256, until one is left (1 pass(es))
        ctx.enqueue_function[reduce_add_int64](b_add, b_addr, Int32(8), grid_dim=1, block_dim=TPB)
        # reduce max %add -> %maxr: a partial per block of 256, until one is left (1 pass(es))
        ctx.enqueue_function[reduce_max_int64](b_add, b_maxr, Int32(8), grid_dim=1, block_dim=TPB)
        # stage 1: 8 element(s), 1 block(s) of TPB
        ctx.enqueue_function[stage1](b_a, b_mul, b_mul_2, Int32(8), grid_dim=1, block_dim=TPB)
        # reduce add %mul_2 -> %addr_2: a partial per block of 256, until one is left (1 pass(es))
        ctx.enqueue_function[reduce_add_int64](b_mul_2, b_addr_2, Int32(8), grid_dim=1, block_dim=TPB)
        # stage 2: 8 element(s), 1 block(s) of TPB
        ctx.enqueue_function[stage2](b_l_2, b_div, Int32(8), grid_dim=1, block_dim=TPB)
        # reduce add %div -> %addr_3: a partial per block of 256, until one is left (1 pass(es))
        ctx.enqueue_function[reduce_add_float32](b_div, b_addr_3, Int32(8), grid_dim=1, block_dim=TPB)
        # stage 3: 8 element(s), 1 block(s) of TPB
        ctx.enqueue_function[stage3](b_div, b_mul_3, Int32(8), grid_dim=1, block_dim=TPB)
        # reduce add %mul_3 -> %addr_4: a partial per block of 256, until one is left (1 pass(es))
        ctx.enqueue_function[reduce_add_float32](b_mul_3, b_addr_4, Int32(8), grid_dim=1, block_dim=TPB)
        # the outputs, back to the host
        var o_0 = ctx.enqueue_create_host_buffer[DType.int64](1)
        ctx.enqueue_copy(dst_buf=o_0, src_buf=b_addr)
        var o_1 = ctx.enqueue_create_host_buffer[DType.int64](1)
        ctx.enqueue_copy(dst_buf=o_1, src_buf=b_maxr)
        var o_2 = ctx.enqueue_create_host_buffer[DType.int64](1)
        ctx.enqueue_copy(dst_buf=o_2, src_buf=b_addr_2)
        var o_3 = ctx.enqueue_create_host_buffer[DType.float32](1)
        ctx.enqueue_copy(dst_buf=o_3, src_buf=b_addr_3)
        var o_4 = ctx.enqueue_create_host_buffer[DType.float32](1)
        ctx.enqueue_copy(dst_buf=o_4, src_buf=b_addr_4)
        ctx.synchronize()
        for i in range(1):
            outputs[unsafe_offset=0][unsafe_offset=i] = Float64(o_0[i])
        for i in range(1):
            outputs[unsafe_offset=1][unsafe_offset=i] = Float64(o_1[i])
        for i in range(1):
            outputs[unsafe_offset=2][unsafe_offset=i] = Float64(o_2[i])
        for i in range(1):
            outputs[unsafe_offset=3][unsafe_offset=i] = Float64(o_3[i])
        for i in range(1):
            outputs[unsafe_offset=4][unsafe_offset=i] = Float64(o_4[i])
        return 0
    except e:
        print("xir_run failed:", e)
        return 1
