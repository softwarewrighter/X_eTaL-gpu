schedule: Float as float, Int as long, work-group 256, products and transposes untiled
buffers:
  b_m: long 6 items, %m i64 [2 3]; constant, uploaded by the host
  b_mt: long 6 items, %mt i64 [3 2]; written on the device
  b_t: long 24 items, %t i64 [2 3 4]; constant, uploaded by the host
  b_tr: long 24 items, %tr i64 [4 3 2]; written on the device
  b_tp: long 24 items, %tp i64 [3 4 2]; written on the device
  b_ts: long 24 items, %ts i64 [2 4 3]; written on the device
  b_v: long 3 items, %v i64 [3]; constant, uploaded by the host
  b_q: float 6 items, %q f64 [2 3]; constant, uploaded by the host
  b_k: float 12 items, %k f64 [4 3]; constant, uploaded by the host
  b_kt: float 12 items, %kt f64 [3 4]; written on the device
  b_s: float 8 items, %s f64 [2 4]; written on the device
  b_x: float 8 items, %x f64 [4 2]; constant, uploaded by the host
  b_dy: float 12 items, %dy f64 [4 3]; constant, uploaded by the host
  b_xt: float 8 items, %xt f64 [2 4]; written on the device
  b_g: float 6 items, %g f64 [2 3]; written on the device
kernels:
  transpose0: 6 elements, one work-item each; computes %mt; writes %mt
  transpose1: 24 elements, one work-item each; computes %tr; writes %tr
  transpose2: 24 elements, one work-item each; computes %tp; writes %tp
  transpose3: 24 elements, one work-item each; computes %ts; writes %ts
  transpose4: 12 elements, one work-item each; computes %kt; writes %kt
  matmul_float: sums of products, one work-item per result item, folded from the right; computes %s %g
  transpose6: 8 elements, one work-item each; computes %xt; writes %xt
launches:
  1: transpose0(b_m, b_mt) global 8 local 8: %mt: o_\, the axes reversed, [2 3] to [3 2], 6 items gathered
  2: transpose1(b_t, b_tr) global 32 local 32: %tr: o_\, the axes reversed, [2 3 4] to [4 3 2], 24 items gathered
  3: transpose2(b_t, b_tp) global 32 local 32: %tp: 3 1 2 t_ranspose, [2 3 4] to [3 4 2], 24 items gathered
  4: transpose3(b_t, b_ts) global 32 local 32: %ts: 1 3 2 t_ranspose, [2 3 4] to [2 4 3], 24 items gathered
  5: transpose4(b_k, b_kt) global 16 local 16: %kt: o_\, the axes reversed, [4 3] to [3 4], 12 items gathered
  6: matmul_float(b_q, b_kt, b_s, 2, 3, 4) global 8 local 8: %s: 2 by 3 times 3 by 4, 8 sums of 3 products, one work-item each
  7: transpose6(b_x, b_xt) global 8 local 8: %xt: o_\, the axes reversed, [4 2] to [2 4], 8 items gathered
  8: matmul_float(b_xt, b_dy, b_g, 2, 4, 3) global 8 local 8: %g: 2 by 4 times 4 by 3, 6 sums of 4 products, one work-item each
outputs:
  %mt from b_mt, read back by the host
  %tr from b_tr, read back by the host
  %tp from b_tp, read back by the host
  %ts from b_ts, read back by the host
  %vt from b_v, read back by the host
  %s from b_s, read back by the host
  %g from b_g, read back by the host
