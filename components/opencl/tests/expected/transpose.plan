schedule: Float as float, Int as long, work-group 256, products and transposes untiled
buffers:
  b_m: long 6 items, %m i64 [2 3]; constant, uploaded by the host
  b_t: long 6 items, %t i64 [3 2]; written on the device
  b_t_2: long 24 items, %t_2 i64 [2 3 4]; constant, uploaded by the host
  b_t_3: long 24 items, %t_3 i64 [4 3 2]; written on the device
  b_tr: long 24 items, %tr i64 [3 4 2]; written on the device
  b_t_4: long 24 items, %t_4 i64 [2 4 3]; written on the device
  b_x: long 3 items, %x i64 [3]; constant, uploaded by the host
  b_q: float 6 items, %q f64 [2 3]; constant, uploaded by the host
  b_k: float 12 items, %k f64 [4 3]; constant, uploaded by the host
  b_t_6: float 12 items, %t_6 f64 [3 4]; written on the device
  b_mm: float 8 items, %mm f64 [2 4]; written on the device
  b_x_2: float 8 items, %x_2 f64 [4 2]; constant, uploaded by the host
  b_dy: float 12 items, %dy f64 [4 3]; constant, uploaded by the host
  b_t_7: float 8 items, %t_7 f64 [2 4]; written on the device
  b_mm_2: float 6 items, %mm_2 f64 [2 3]; written on the device
kernels:
  transpose0: 6 elements, one work-item each; computes %t; writes %t
  transpose1: 24 elements, one work-item each; computes %t_3; writes %t_3
  transpose2: 24 elements, one work-item each; computes %tr; writes %tr
  transpose3: 24 elements, one work-item each; computes %t_4; writes %t_4
  transpose4: 12 elements, one work-item each; computes %t_6; writes %t_6
  matmul_float: sums of products, one work-item per result item, folded from the right; computes %mm %mm_2
  transpose6: 8 elements, one work-item each; computes %t_7; writes %t_7
launches:
  1: transpose0(b_m, b_t) global 8 local 8: %t: o_\, the axes reversed, [2 3] to [3 2], 6 items gathered
  2: transpose1(b_t_2, b_t_3) global 32 local 32: %t_3: o_\, the axes reversed, [2 3 4] to [4 3 2], 24 items gathered
  3: transpose2(b_t_2, b_tr) global 32 local 32: %tr: 3 1 2 t_ranspose, [2 3 4] to [3 4 2], 24 items gathered
  4: transpose3(b_t_2, b_t_4) global 32 local 32: %t_4: 1 3 2 t_ranspose, [2 3 4] to [2 4 3], 24 items gathered
  5: transpose4(b_k, b_t_6) global 16 local 16: %t_6: o_\, the axes reversed, [4 3] to [3 4], 12 items gathered
  6: matmul_float(b_q, b_t_6, b_mm, 2, 3, 4) global 8 local 8: %mm: 2 by 3 times 3 by 4, 8 sums of 3 products, one work-item each
  7: transpose6(b_x_2, b_t_7) global 8 local 8: %t_7: o_\, the axes reversed, [4 2] to [2 4], 8 items gathered
  8: matmul_float(b_t_7, b_dy, b_mm_2, 2, 4, 3) global 8 local 8: %mm_2: 2 by 4 times 4 by 3, 6 sums of 4 products, one work-item each
outputs:
  %t from b_t, read back by the host
  %t_3 from b_t_3, read back by the host
  %tr from b_tr, read back by the host
  %t_4 from b_t_4, read back by the host
  %t_5 from b_x, read back by the host
  %mm from b_mm, read back by the host
  %mm_2 from b_mm_2, read back by the host
