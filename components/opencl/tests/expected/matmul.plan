schedule: Float as float, Int as long, work-group 256, products untiled
buffers:
  b_a: long 12 items, %a i64 [3 4]; constant, uploaded by the host
  b_b: long 8 items, %b i64 [4 2]; constant, uploaded by the host
  b_ab: long 6 items, %ab i64 [3 2]; written on the device
  b_v: long 4 items, %v i64 [4]; constant, uploaded by the host
  b_av: long 3 items, %av i64 [3]; written on the device
  b_u: long 3 items, %u i64 [3]; constant, uploaded by the host
  b_ua: long 4 items, %ua i64 [4]; written on the device
  b_g0: float 12 items, %g0 f64 [4 3]; constant, uploaded by the host
  b_f: float 12 items, %f f64 [3 4]; written on the device
  b_g: float 12 items, %g f64 [4 3]; written on the device
  b_fg: float 9 items, %fg f64 [3 3]; written on the device
kernels:
  matmul_long: sums of products, one work-item per result item, folded from the right; computes %ab %av %ua
  k0: 12 elements, one work-item each; computes %af %f; writes %f
  k1: 12 elements, one work-item each; computes %g; writes %g
  matmul_float: sums of products, one work-item per result item, folded from the right; computes %fg
launches:
  1: matmul_long(b_a, b_b, b_ab, 3, 4, 2) global 8 local 8: %ab: 3 by 4 times 4 by 2, 6 sums of 4 products, one work-item each
  2: matmul_long(b_a, b_v, b_av, 3, 4, 1) global 4 local 4: %av: 3 by 4 times 4 by 1, 3 sums of 4 products, one work-item each
  3: matmul_long(b_u, b_a, b_ua, 1, 3, 4) global 4 local 4: %ua: 1 by 3 times 3 by 4, 4 sums of 3 products, one work-item each
  4: k0(b_a, b_f) global 16 local 16: 12 elements (1 group of 16)
  5: k1(b_g0, b_g) global 16 local 16: 12 elements (1 group of 16)
  6: matmul_float(b_f, b_g, b_fg, 3, 4, 3) global 16 local 16: %fg: 3 by 4 times 4 by 3, 9 sums of 4 products, one work-item each
outputs:
  %ab from b_ab, read back by the host
  %av from b_av, read back by the host
  %ua from b_ua, read back by the host
  %fg from b_fg, read back by the host
