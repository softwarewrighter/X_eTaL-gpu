schedule: Float as float, Int as long, work-group 256, products and transposes untiled
buffers:
  b_w1: float 20 items, %w1 f64 [4 5]; constant, uploaded by the host
  b_w2: float 12 items, %w2 f64 [6 2]; constant, uploaded by the host
  b_x: float 12 items, %x f64 [4 3]; constant, uploaded by the host
  b_take: float 5 items, %take f64 [1 5]; written on the device
  b_a: long 4 items, %a i64 [4]; constant, uploaded by the host
  b_tb: float 20 items, %tb f64 [4 5]; written on the device
  b_drop: float 15 items, %drop f64 [3 5]; written on the device
  b_mm: float 20 items, %mm f64 [4 5]; written on the device
  b_max: float 20 items, %max f64 [4 5]; written on the device
  b_take_2: float 2 items, %take_2 f64 [1 2]; written on the device
  b_a_2: long 4 items, %a_2 i64 [4]; constant, uploaded by the host
  b_tb_2: float 8 items, %tb_2 f64 [4 2]; written on the device
  b_drop_2: float 10 items, %drop_2 f64 [5 2]; written on the device
  b_mm_2: float 8 items, %mm_2 f64 [4 2]; written on the device
  b_add_2: float 8 items, %add_2 f64 [4 2]; written on the device
  b_maxr: float 4 items, %maxr f64 [4]; written on the device
  b_b: long 2 items, %b i64 [2]; constant, uploaded by the host
  b_tb_3: float 8 items, %tb_3 f64 [4 2]; written on the device
  b_exp: float 8 items, %exp f64 [4 2]; written on the device
  b_addr: float 4 items, %addr f64 [4]; written on the device
  b_b_2: long 2 items, %b_2 i64 [2]; constant, uploaded by the host
  b_tb_4: float 8 items, %tb_4 f64 [4 2]; written on the device
  b_div: float 8 items, %div f64 [4 2]; written on the device
  b_addr_2: float 4 items, %addr_2 f64 [4]; written on the device
kernels:
  slice_float: a take or a drop along an axis: the items kept of every line, one work-item per item; computes %take %drop %take_2 %drop_2
  table1: 20 elements, one work-item each; computes %tb; writes %tb
  matmul_float: sums of products, one work-item per result item, folded from the right; computes %mm %mm_2
  k1: 20 elements, one work-item each; computes %add %max; writes %max
  table6: 8 elements, one work-item each; computes %tb_2; writes %tb_2
  k3: 8 elements, one work-item each; computes %add_2; writes %add_2
  reduce_axis_max_float: along one axis, one work-item per result item folding its line from the right; computes %maxr
  table11: 8 elements, one work-item each; computes %tb_3; writes %tb_3
  k5: 8 elements, one work-item each; computes %sub %exp; writes %exp
  reduce_axis_add_float: along one axis, one work-item per result item folding its line from the right; computes %addr %addr_2
  table14: 8 elements, one work-item each; computes %tb_4; writes %tb_4
  k7: 8 elements, one work-item each; computes %div; writes %div
launches:
  1: slice_float(b_w1, b_take, 1, 4, 5, 3, 1) global 8 local 8: %take: 5 items from item 15
  2: table1(b_a, b_take, b_tb) global 32 local 32: %tb: right table, 4 by 5 items
  3: slice_float(b_w1, b_drop, 1, 4, 5, 0, 3) global 16 local 16: %drop: 15 items from item 0
  4: matmul_float(b_x, b_drop, b_mm, 4, 3, 5) global 32 local 32: %mm: 4 by 3 times 3 by 5, 20 sums of 3 products, one work-item each
  5: k1(b_mm, b_tb, b_max) global 32 local 32: 20 elements (1 group of 32)
  6: slice_float(b_w2, b_take_2, 1, 6, 2, 5, 1) global 2 local 2: %take_2: 2 items from item 10
  7: table6(b_a_2, b_take_2, b_tb_2) global 8 local 8: %tb_2: right table, 4 by 2 items
  8: slice_float(b_w2, b_drop_2, 1, 6, 2, 0, 5) global 16 local 16: %drop_2: 10 items from item 0
  9: matmul_float(b_max, b_drop_2, b_mm_2, 4, 5, 2) global 8 local 8: %mm_2: 4 by 5 times 5 by 2, 8 sums of 5 products, one work-item each
  10: k3(b_mm_2, b_tb_2, b_add_2) global 8 local 8: 8 elements (1 group of 8)
  11: reduce_axis_max_float(b_add_2, b_maxr, 4, 2, 1) global 4 local 4: %maxr: max along axis 2: 4 lines of 2, one work-item each
  12: table11(b_maxr, b_b, b_tb_3) global 8 local 8: %tb_3: left table, 4 by 2 items
  13: k5(b_add_2, b_tb_3, b_exp) global 8 local 8: 8 elements (1 group of 8)
  14: reduce_axis_add_float(b_exp, b_addr, 4, 2, 1) global 4 local 4: %addr: add along axis 2: 4 lines of 2, one work-item each
  15: table14(b_addr, b_b_2, b_tb_4) global 8 local 8: %tb_4: left table, 4 by 2 items
  16: k7(b_exp, b_tb_4, b_div) global 8 local 8: 8 elements (1 group of 8)
  17: reduce_axis_add_float(b_div, b_addr_2, 4, 2, 1) global 4 local 4: %addr_2: add along axis 2: 4 lines of 2, one work-item each
outputs:
  %div from b_div, read back by the host
  %addr_2 from b_addr_2, read back by the host
