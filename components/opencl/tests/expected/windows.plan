schedule: Float as float, Int as long, work-group 256, products and transposes untiled
buffers:
  b_v: long 5 items, %v i64 [5]; constant, uploaded by the host
  b_r1: long 5 items, %r1 i64 [5]; written on the device
  b_r3: long 15 items, %r3 i64 [3 5]; written on the device
  b_x: float 24 items, %x f64 [2 3 4]; constant, uploaded by the host
  b_a: float 72 items, %a f64 [3 2 3 4]; written on the device
  b_b: float 216 items, %b f64 [3 3 2 3 4]; written on the device
  b_c: float 144 items, %c f64 [3 3 2 2 4]; written on the device
  b_d: float 72 items, %d f64 [3 3 2 1 4]; written on the device
  b_e: float 54 items, %e f64 [3 3 2 1 3]; written on the device
  b_f: float 36 items, %f f64 [3 3 2 1 2]; written on the device
  b_k: float 18 items, %k f64 [2 9]; constant, uploaded by the host
  b_kw: float 8 items, %kw f64 [2 4]; written on the device
  b_t: float 8 items, %t f64 [2 2 2]; written on the device
kernels:
  rotate0: 5 elements, one work-item each; computes %r1; writes %r1
  rotate1: 15 elements, one work-item each; computes %r3; writes %r3
  rotate2: 72 elements, one work-item each; computes %a; writes %a
  rotate3: 216 elements, one work-item each; computes %b; writes %b
  slice_float: a take or a drop along an axis: the items kept of every line, one work-item per item; computes %c %d %e %f
  matmul_float: sums of products, one work-item per result item, folded from the right; computes %kw
  transpose9: 8 elements, one work-item each; computes %t; writes %t
launches:
  1: rotate0(b_v, b_r1) global 8 local 8: %r1: 1 o_-_1, 1 copy of 5 items gathered
  2: rotate1(b_v, b_r3) global 16 local 16: %r3: -1 0 1 o_-_1, 3 copies of 5 items gathered
  3: rotate2(b_x, b_a) global 128 local 128: %a: -1 0 1 o_-_3, 3 copies of 24 items gathered
  4: rotate3(b_a, b_b) global 256 local 256: %b: -1 0 1 o_-_3, 3 copies of 72 items gathered
  5: slice_float(b_b, b_c, 18, 3, 4, 0, 2) global 256 local 256: %c: 2 of 3 along the axis, 18 lines of 4 each: 144 items
  6: slice_float(b_c, b_d, 18, 2, 4, 1, 1) global 128 local 128: %d: 1 of 2 along the axis, 18 lines of 4 each: 72 items
  7: slice_float(b_d, b_e, 18, 4, 1, 0, 3) global 64 local 64: %e: 3 of 4 along the axis, 18 lines of 1 each: 54 items
  8: slice_float(b_e, b_f, 18, 3, 1, 1, 2) global 64 local 64: %f: 2 of 3 along the axis, 18 lines of 1 each: 36 items
  9: matmul_float(b_k, b_f, b_kw, 2, 9, 4) global 8 local 8: %kw: 2 by 9 times 9 by 4, 8 sums of 9 products, one work-item each
  10: transpose9(b_kw, b_t) global 8 local 8: %t: 2 1 3 t_ranspose, [2 2 2] to [2 2 2], 8 items gathered
outputs:
  %r1 from b_r1, read back by the host
  %r3 from b_r3, read back by the host
  %w from b_f, read back by the host
  %y from b_t, read back by the host
