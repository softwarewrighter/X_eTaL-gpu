schedule: Float as float, Int as long, work-group 256, products and transposes untiled
buffers:
  b_m: long 12 items, %m i64 [3 4]; constant, uploaded by the host
  b_addr: long 3 items, %addr i64 [3]; written on the device
  b_addr_2: long 4 items, %addr_2 i64 [4]; written on the device
  b_maxr: long 3 items, %maxr i64 [3]; written on the device
  b_l: float 12 items, %l f64 [3 4]; constant, uploaded by the host
  b_div: float 12 items, %div f64 [3 4]; written on the device
  b_addr_3: float 3 items, %addr_3 f64 [3]; written on the device
  b_addr_4: float 4 items, %addr_4 f64 [4]; written on the device
  b_addr_5: float 3 items, %addr_5 f64 [3]; written on the device
  b_addr_6: float 1 item, %addr_6 f64 []; written on the device
kernels:
  reduce_axis_add_long: along one axis, one work-item per result item folding its line from the right; computes %addr %addr_2
  reduce_axis_max_long: along one axis, one work-item per result item folding its line from the right; computes %maxr
  k0: 12 elements, one work-item each; computes %div; writes %div
  reduce_axis_add_float: along one axis, one work-item per result item folding its line from the right; computes %addr_3 %addr_4 %addr_5
  reduce_add_float: a tree reduction in local memory, one partial per work-group; computes %addr_6
launches:
  1: reduce_axis_add_long(b_m, b_addr, 3, 4, 1) global 4 local 4: %addr: add along axis 2: 3 lines of 4, one work-item each
  2: reduce_axis_add_long(b_m, b_addr_2, 1, 3, 4) global 4 local 4: %addr_2: add along axis 1: 4 lines of 3, one work-item each
  3: reduce_axis_max_long(b_m, b_maxr, 3, 4, 1) global 4 local 4: %maxr: max along axis 2: 3 lines of 4, one work-item each
  4: k0(b_l, b_div) global 16 local 16: 12 elements (1 group of 16)
  5: reduce_axis_add_float(b_div, b_addr_3, 3, 4, 1) global 4 local 4: %addr_3: add along axis 2: 3 lines of 4, one work-item each
  6: reduce_axis_add_float(b_div, b_addr_4, 1, 3, 4) global 4 local 4: %addr_4: add along axis 1: 4 lines of 3, one work-item each
  7: reduce_axis_add_float(b_div, b_addr_5, 3, 4, 1) global 4 local 4: %addr_5: add along axis 2: 3 lines of 4, one work-item each
  8: reduce_add_float(b_addr_5, b_addr_6, 3, local 1024 bytes) global 256 local 256: %addr_6: add 3 items to 1 partial (pass 1)
outputs:
  %m from b_m, read back by the host
  %addr from b_addr, read back by the host
  %addr_2 from b_addr_2, read back by the host
  %maxr from b_maxr, read back by the host
  %addr_3 from b_addr_3, read back by the host
  %addr_4 from b_addr_4, read back by the host
  %addr_6 from b_addr_6, read back by the host
