schedule: Float as float, Int as long, work-group 256, products and transposes untiled
buffers:
  b_a: long 8 items, %a i64 [8]; constant, uploaded by the host
  b_r: long 8 items, %r i64 [8]; constant, uploaded by the host
  b_l_2: float 8 items, %l_2 f64 [8]; constant, uploaded by the host
  b_add: long 8 items, %add i64 [8]; written on the device
  b_add_2: float 8 items, %add_2 f64 [8]; written on the device
kernels:
  k0: 8 elements, one work-item each; computes %mul %add %div %mul_2 %add_2; writes %add %add_2
launches:
  1: k0(b_r, b_a, b_l_2, b_add, b_add_2) global 8 local 8: 8 elements (1 group of 8)
outputs:
  %add from b_add, read back by the host
  %add_2 from b_add_2, read back by the host
