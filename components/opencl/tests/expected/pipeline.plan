schedule: Float as float, Int as long, work-group 256, products untiled
buffers:
  b_x: long 8 items, %x i64 [8]; constant, uploaded by the host
  b_w: long 8 items, %w i64 [8]; constant, uploaded by the host
  b_pos: long 8 items, %pos i64 [8]; written on the device
  b_sum: long 1 item, %sum i64 []; written on the device
  b_r: float 8 items, %r f64 [8]; constant, uploaded by the host
  b_g: float 8 items, %g f64 [8]; constant, uploaded by the host
  b_fpos: float 8 items, %fpos f64 [8]; written on the device
  b_fsum: float 1 item, %fsum f64 []; written on the device
kernels:
  k0: 8 elements, one work-item each; computes %xw %s %pos; writes %pos
  reduce_add_long: a tree reduction in local memory, one partial per work-group; computes %sum
  k1: 8 elements, one work-item each; computes %f %fg %fs %fpos; writes %fpos
  reduce_add_float: a tree reduction in local memory, one partial per work-group; computes %fsum
launches:
  1: k0(b_x, b_w, b_pos) global 8 local 8: 8 elements (1 group of 8)
  2: reduce_add_long(b_pos, b_sum, 8, local 2048 bytes) global 256 local 256: %sum: add 8 items to 1 partial (pass 1)
  3: k1(b_r, b_g, b_fpos) global 8 local 8: 8 elements (1 group of 8)
  4: reduce_add_float(b_fpos, b_fsum, 8, local 1024 bytes) global 256 local 256: %fsum: add 8 items to 1 partial (pass 1)
outputs:
  %sum from b_sum, read back by the host
  %fsum from b_fsum, read back by the host
