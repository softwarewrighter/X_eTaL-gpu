schedule: Float as float, Int as long, work-group 256, products and transposes untiled
buffers:
  b_a: long 8 items, %a i64 [8]; constant, uploaded by the host
  b_mul: long 8 items, %mul i64 [8]; written on the device
  b_add: long 8 items, %add i64 [8]; written on the device
  b_addr: long 1 item, %addr i64 []; written on the device
  b_maxr: long 1 item, %maxr i64 []; written on the device
  b_mul_2: long 8 items, %mul_2 i64 [8]; written on the device
  b_addr_2: long 1 item, %addr_2 i64 []; written on the device
  b_l_2: float 8 items, %l_2 f64 [8]; constant, uploaded by the host
  b_div: float 8 items, %div f64 [8]; written on the device
  b_addr_3: float 1 item, %addr_3 f64 []; written on the device
  b_mul_3: float 8 items, %mul_3 f64 [8]; written on the device
  b_addr_4: float 1 item, %addr_4 f64 []; written on the device
kernels:
  k0: 8 elements, one work-item each; computes %mul %add; writes %mul %add
  reduce_add_long: a tree reduction in local memory, one partial per work-group; computes %addr %addr_2
  reduce_max_long: a tree reduction in local memory, one partial per work-group; computes %maxr
  k1: 8 elements, one work-item each; computes %mul_2; writes %mul_2
  k2: 8 elements, one work-item each; computes %div; writes %div
  reduce_add_float: a tree reduction in local memory, one partial per work-group; computes %addr_3 %addr_4
  k3: 8 elements, one work-item each; computes %mul_3; writes %mul_3
launches:
  1: k0(b_a, b_mul, b_add) global 8 local 8: 8 elements (1 group of 8)
  2: reduce_add_long(b_add, b_addr, 8, local 2048 bytes) global 256 local 256: %addr: add 8 items to 1 partial (pass 1)
  3: reduce_max_long(b_add, b_maxr, 8, local 2048 bytes) global 256 local 256: %maxr: max 8 items to 1 partial (pass 1)
  4: k1(b_a, b_mul, b_mul_2) global 8 local 8: 8 elements (1 group of 8)
  5: reduce_add_long(b_mul_2, b_addr_2, 8, local 2048 bytes) global 256 local 256: %addr_2: add 8 items to 1 partial (pass 1)
  6: k2(b_l_2, b_div) global 8 local 8: 8 elements (1 group of 8)
  7: reduce_add_float(b_div, b_addr_3, 8, local 1024 bytes) global 256 local 256: %addr_3: add 8 items to 1 partial (pass 1)
  8: k3(b_div, b_mul_3) global 8 local 8: 8 elements (1 group of 8)
  9: reduce_add_float(b_mul_3, b_addr_4, 8, local 1024 bytes) global 256 local 256: %addr_4: add 8 items to 1 partial (pass 1)
outputs:
  %addr from b_addr, read back by the host
  %maxr from b_maxr, read back by the host
  %addr_2 from b_addr_2, read back by the host
  %addr_3 from b_addr_3, read back by the host
  %addr_4 from b_addr_4, read back by the host
