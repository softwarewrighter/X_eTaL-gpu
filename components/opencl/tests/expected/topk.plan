  b_b_11: long 5 items, %b_11 i64 [5]; constant, uploaded by the host
  b_tb_11: float 20 items, %tb_11 f64 [4 5]; written on the device
  b_sub_11: float 20 items, %sub_11 f64 [4 5]; written on the device
