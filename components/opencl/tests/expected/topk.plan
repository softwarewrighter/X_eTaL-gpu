  b_tb_6: float 12 items, %tb_6 f64 [3 4]; written on the device
  b_maxr_6: float 3 items, %maxr_6 f64 [3]; written on the device
  b_b_7: long 4 items, %b_7 i64 [4]; constant, uploaded by the host
  b_tb_7: float 12 items, %tb_7 f64 [3 4]; written on the device
  b_s: float 20 items, %s f64 [4 5]; constant, uploaded by the host
  b_f_6: float 12 items, %f_6 f64 [3 4]; written on the device
  b_maxr_7: float 4 items, %maxr_7 f64 [4]; written on the device
  b_b_8: long 5 items, %b_8 i64 [5]; constant, uploaded by the host
  b_tb_8: float 20 items, %tb_8 f64 [4 5]; written on the device
  b_a_2: long 4 items, %a_2 i64 [4]; constant, uploaded by the host
  b_b_9: float 5 items, %b_9 f64 [5]; constant, uploaded by the host
  b_f_7: float 20 items, %f_7 f64 [4 5]; written on the device
