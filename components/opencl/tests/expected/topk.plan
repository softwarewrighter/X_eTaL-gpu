schedule: Float as float, Int as long, work-group 256, products and transposes untiled
buffers:
  b_m: float 12 items, %m f64 [3 4]; constant, uploaded by the host
  b_maxr: float 3 items, %maxr f64 [3]; written on the device
  b_b: long 4 items, %b i64 [4]; constant, uploaded by the host
  b_tb: float 12 items, %tb f64 [3 4]; written on the device
  b_a: long 3 items, %a i64 [3]; constant, uploaded by the host
  b_b_2: float 4 items, %b_2 f64 [4]; constant, uploaded by the host
  b_f: float 12 items, %f f64 [3 4]; written on the device
  b_mul: float 12 items, %mul f64 [3 4]; written on the device
  b_tb_2: float 12 items, %tb_2 f64 [3 4]; written on the device
  b_add: float 12 items, %add f64 [3 4]; written on the device
  b_minr: float 3 items, %minr f64 [3]; written on the device
  b_fl: long 3 items, %fl i64 [3]; written on the device
  b_minr_2: float 3 items, %minr_2 f64 [3]; written on the device
  b_add_2: float 3 items, %add_2 f64 [3]; written on the device
  b_tb_3: float 12 items, %tb_3 f64 [3 4]; written on the device
  b_sub_3: float 12 items, %sub_3 f64 [3 4]; written on the device
  b_maxr_2: float 3 items, %maxr_2 f64 [3]; written on the device
  b_tb_4: float 12 items, %tb_4 f64 [3 4]; written on the device
  b_s: float 20 items, %s f64 [4 5]; constant, uploaded by the host
  b_f_3: float 12 items, %f_3 f64 [3 4]; written on the device
  b_f_4: float 12 items, %f_4 f64 [3 4]; written on the device
  b_maxr_3: float 4 items, %maxr_3 f64 [4]; written on the device
  b_b_3: long 5 items, %b_3 i64 [5]; constant, uploaded by the host
  b_tb_5: float 20 items, %tb_5 f64 [4 5]; written on the device
  b_b_4: float 5 items, %b_4 f64 [5]; constant, uploaded by the host
  b_f_5: float 20 items, %f_5 f64 [4 5]; written on the device
  b_mul_5: float 20 items, %mul_5 f64 [4 5]; written on the device
  b_tb_6: float 20 items, %tb_6 f64 [4 5]; written on the device
  b_add_3: float 20 items, %add_3 f64 [4 5]; written on the device
  b_minr_3: float 4 items, %minr_3 f64 [4]; written on the device
  b_fl_2: long 4 items, %fl_2 i64 [4]; written on the device
  b_minr_4: float 4 items, %minr_4 f64 [4]; written on the device
  b_add_4: float 4 items, %add_4 f64 [4]; written on the device
  b_tb_7: float 20 items, %tb_7 f64 [4 5]; written on the device
  b_sub_9: float 20 items, %sub_9 f64 [4 5]; written on the device
  b_maxr_4: float 4 items, %maxr_4 f64 [4]; written on the device
  b_tb_8: float 20 items, %tb_8 f64 [4 5]; written on the device
  b_sub_10: float 20 items, %sub_10 f64 [4 5]; written on the device
  b_maxr_5: float 4 items, %maxr_5 f64 [4]; written on the device
  b_tb_9: float 20 items, %tb_9 f64 [4 5]; written on the device
  b_f_8: float 20 items, %f_8 f64 [4 5]; written on the device
  b_mul_10: float 20 items, %mul_10 f64 [4 5]; written on the device
kernels:
  reduce_axis_max_float: along one axis, one work-item per result item folding its line from the right; computes %maxr %maxr_2 %maxr_3 %maxr_4 %maxr_5
  table1: 12 elements, one work-item each; computes %tb; writes %tb
  k1: 12 elements, one work-item each; computes %eq %f %sub %mul; writes %f %mul
  table3: 12 elements, one work-item each; computes %tb_2; writes %tb_2
  k3: 12 elements, one work-item each; computes %mul_2 %add; writes %add
  reduce_axis_min_float: along one axis, one work-item per result item folding its line from the right; computes %minr %minr_2 %minr_3 %minr_4
  k4: 3 elements, one work-item each; computes %fl; writes %fl
  k5: 3 elements, one work-item each; computes %sub_2 %add_2; writes %add_2
  table9: 12 elements, one work-item each; computes %tb_3; writes %tb_3
  k7: 12 elements, one work-item each; computes %mul_3 %sub_3; writes %sub_3
  table12: 12 elements, one work-item each; computes %tb_4; writes %tb_4
  k9: 12 elements, one work-item each; computes %eq_2 %f_2 %mul_4 %sub_4 %sub_5 %gt %f_3 %sub_6 %gt_2 %f_4; writes %f_3 %f_4
  table15: 20 elements, one work-item each; computes %tb_5; writes %tb_5
  k11: 20 elements, one work-item each; computes %eq_3 %f_5 %sub_7 %mul_5; writes %f_5 %mul_5
  table17: 20 elements, one work-item each; computes %tb_6; writes %tb_6
  k13: 20 elements, one work-item each; computes %mul_6 %add_3; writes %add_3
  k14: 4 elements, one work-item each; computes %fl_2; writes %fl_2
  k15: 4 elements, one work-item each; computes %sub_8 %add_4; writes %add_4
  table23: 20 elements, one work-item each; computes %tb_7; writes %tb_7
  k17: 20 elements, one work-item each; computes %mul_7 %sub_9; writes %sub_9
  table26: 20 elements, one work-item each; computes %tb_8; writes %tb_8
  k19: 20 elements, one work-item each; computes %eq_4 %f_6 %mul_8 %sub_10; writes %sub_10
  table29: 20 elements, one work-item each; computes %tb_9; writes %tb_9
  k21: 20 elements, one work-item each; computes %eq_5 %f_7 %mul_9 %sub_11 %sub_12 %gt_3 %f_8 %mul_10; writes %f_8 %mul_10
launches:
  1: reduce_axis_max_float(b_m, b_maxr, 3, 4, 1) global 4 local 4: %maxr: max along axis 2: 3 lines of 4, one work-item each
  2: table1(b_maxr, b_b, b_tb) global 16 local 16: %tb: left table, 3 by 4 items
  3: k1(b_m, b_tb, b_f, b_mul) global 16 local 16: 12 elements (1 group of 16)
  4: table3(b_a, b_b_2, b_tb_2) global 16 local 16: %tb_2: right table, 3 by 4 items
  5: k3(b_f, b_tb_2, b_mul, b_add) global 16 local 16: 12 elements (1 group of 16)
  6: reduce_axis_min_float(b_add, b_minr, 3, 4, 1) global 4 local 4: %minr: min along axis 2: 3 lines of 4, one work-item each
  7: k4(b_minr, b_fl) global 4 local 4: 3 elements (1 group of 4)
  8: reduce_axis_min_float(b_m, b_minr_2, 3, 4, 1) global 4 local 4: %minr_2: min along axis 2: 3 lines of 4, one work-item each
  9: k5(b_maxr, b_minr_2, b_add_2) global 4 local 4: 3 elements (1 group of 4)
  10: table9(b_add_2, b_b, b_tb_3) global 16 local 16: %tb_3: left table, 3 by 4 items
  11: k7(b_tb_3, b_f, b_m, b_sub_3) global 16 local 16: 12 elements (1 group of 16)
  12: reduce_axis_max_float(b_sub_3, b_maxr_2, 3, 4, 1) global 4 local 4: %maxr_2: max along axis 2: 3 lines of 4, one work-item each
  13: table12(b_maxr_2, b_b, b_tb_4) global 16 local 16: %tb_4: left table, 3 by 4 items
  14: k9(b_sub_3, b_tb_4, b_tb_3, b_m, b_f_3, b_f_4) global 16 local 16: 12 elements (1 group of 16)
  15: reduce_axis_max_float(b_s, b_maxr_3, 4, 5, 1) global 4 local 4: %maxr_3: max along axis 2: 4 lines of 5, one work-item each
  16: table15(b_maxr_3, b_b_3, b_tb_5) global 32 local 32: %tb_5: left table, 4 by 5 items
  17: k11(b_s, b_tb_5, b_f_5, b_mul_5) global 32 local 32: 20 elements (1 group of 32)
  18: table17(b_b, b_b_4, b_tb_6) global 32 local 32: %tb_6: right table, 4 by 5 items
  19: k13(b_f_5, b_tb_6, b_mul_5, b_add_3) global 32 local 32: 20 elements (1 group of 32)
  20: reduce_axis_min_float(b_add_3, b_minr_3, 4, 5, 1) global 4 local 4: %minr_3: min along axis 2: 4 lines of 5, one work-item each
  21: k14(b_minr_3, b_fl_2) global 4 local 4: 4 elements (1 group of 4)
  22: reduce_axis_min_float(b_s, b_minr_4, 4, 5, 1) global 4 local 4: %minr_4: min along axis 2: 4 lines of 5, one work-item each
  23: k15(b_maxr_3, b_minr_4, b_add_4) global 4 local 4: 4 elements (1 group of 4)
  24: table23(b_add_4, b_b_3, b_tb_7) global 32 local 32: %tb_7: left table, 4 by 5 items
  25: k17(b_tb_7, b_f_5, b_s, b_sub_9) global 32 local 32: 20 elements (1 group of 32)
  26: reduce_axis_max_float(b_sub_9, b_maxr_4, 4, 5, 1) global 4 local 4: %maxr_4: max along axis 2: 4 lines of 5, one work-item each
  27: table26(b_maxr_4, b_b_3, b_tb_8) global 32 local 32: %tb_8: left table, 4 by 5 items
  28: k19(b_sub_9, b_tb_8, b_tb_7, b_sub_10) global 32 local 32: 20 elements (1 group of 32)
  29: reduce_axis_max_float(b_sub_10, b_maxr_5, 4, 5, 1) global 4 local 4: %maxr_5: max along axis 2: 4 lines of 5, one work-item each
  30: table29(b_maxr_5, b_b_3, b_tb_9) global 32 local 32: %tb_9: left table, 4 by 5 items
  31: k21(b_sub_10, b_tb_9, b_tb_7, b_s, b_f_8, b_mul_10) global 32 local 32: 20 elements (1 group of 32)
outputs:
  %fl from b_fl, read back by the host
  %f_3 from b_f_3, read back by the host
  %f_4 from b_f_4, read back by the host
  %fl_2 from b_fl_2, read back by the host
  %f_8 from b_f_8, read back by the host
  %mul_10 from b_mul_10, read back by the host
