  b_b_2: float 4 items, %b_2 f64 [4]; constant, uploaded by the host
  b_f: float 12 items, %f f64 [3 4]; written on the device
  b_mul: float 12 items, %mul f64 [3 4]; written on the device
  b_tb_2: float 12 items, %tb_2 f64 [3 4]; written on the device
