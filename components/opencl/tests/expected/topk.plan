  16: table15(b_maxr_4, b_b_5, b_tb_5) global 16 local 16: %tb_5: left table, 3 by 4 items
  17: k10(b_sub_3, b_tb_5, b_tb_3, b_m, b_f_4) global 16 local 16: 12 elements (1 group of 16)
  18: reduce_axis_min_float(b_m, b_minr_3, 3, 4, 1) global 4 local 4: %minr_3: min along axis 2: 3 lines of 4, one work-item each
  19: reduce_axis_max_float(b_m, b_maxr_5, 3, 4, 1) global 4 local 4: %maxr_5: max along axis 2: 3 lines of 4, one work-item each
  20: k11(b_maxr_5, b_minr_3, b_add_3) global 4 local 4: 3 elements (1 group of 4)
