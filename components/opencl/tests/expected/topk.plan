  b_mul_14: float 20 items, %mul_14 f64 [4 5]; written on the device
kernels:
  reduce_axis_max_float: along one axis, one work-item per result item folding its line from the right; computes %maxr %maxr_2 %maxr_3 %maxr_4 %maxr_5 %maxr_6 %maxr_7 %maxr_8 %maxr_9 %maxr_10 %maxr_11 %maxr_12 %maxr_13 %maxr_14 %maxr_15
  table1: 12 elements, one work-item each; computes %tb; writes %tb
  k1: 12 elements, one work-item each; computes %eq %f %sub %mul; writes %f %mul
  table3: 12 elements, one work-item each; computes %tb_2; writes %tb_2
  k3: 12 elements, one work-item each; computes %mul_2 %add; writes %add
  reduce_axis_min_float: along one axis, one work-item per result item folding its line from the right; computes %minr %minr_2 %minr_3 %minr_4 %minr_5 %minr_6
  k4: 3 elements, one work-item each; computes %fl; writes %fl
  k5: 3 elements, one work-item each; computes %sub_2 %add_2; writes %add_2
  table10: 12 elements, one work-item each; computes %tb_3; writes %tb_3
  table12: 12 elements, one work-item each; computes %tb_4; writes %tb_4
  k8: 12 elements, one work-item each; computes %eq_2 %f_2 %mul_3 %sub_3; writes %sub_3
  table15: 12 elements, one work-item each; computes %tb_5; writes %tb_5
  k10: 12 elements, one work-item each; computes %eq_3 %f_3 %mul_4 %sub_4 %sub_5 %gt %f_4; writes %f_4
  k11: 3 elements, one work-item each; computes %sub_6 %add_3; writes %add_3
  table20: 12 elements, one work-item each; computes %tb_6; writes %tb_6
  table22: 12 elements, one work-item each; computes %tb_7; writes %tb_7
  k14: 12 elements, one work-item each; computes %eq_4 %f_5 %mul_5 %sub_7 %sub_8 %gt_2 %f_6; writes %f_6
  table25: 20 elements, one work-item each; computes %tb_8; writes %tb_8
  k16: 20 elements, one work-item each; computes %eq_5 %f_7 %sub_9 %mul_6; writes %f_7 %mul_6
  table27: 20 elements, one work-item each; computes %tb_9; writes %tb_9
  k18: 20 elements, one work-item each; computes %mul_7 %add_4; writes %add_4
  k19: 4 elements, one work-item each; computes %fl_2; writes %fl_2
  k20: 4 elements, one work-item each; computes %sub_10 %add_5; writes %add_5
  table34: 20 elements, one work-item each; computes %tb_10; writes %tb_10
  table36: 20 elements, one work-item each; computes %tb_11; writes %tb_11
  k23: 20 elements, one work-item each; computes %eq_6 %f_8 %mul_8 %sub_11; writes %sub_11
  table39: 20 elements, one work-item each; computes %tb_12; writes %tb_12
  k25: 20 elements, one work-item each; computes %eq_7 %f_9 %mul_9 %sub_12; writes %sub_12
  table42: 20 elements, one work-item each; computes %tb_13; writes %tb_13
  k27: 20 elements, one work-item each; computes %eq_8 %f_10 %mul_10 %sub_13 %sub_14 %gt_3 %f_11; writes %f_11
  k28: 4 elements, one work-item each; computes %sub_15 %add_6; writes %add_6
  table47: 20 elements, one work-item each; computes %tb_14; writes %tb_14
  table49: 20 elements, one work-item each; computes %tb_15; writes %tb_15
  k31: 20 elements, one work-item each; computes %eq_9 %f_12 %mul_11 %sub_16; writes %sub_16
  table52: 20 elements, one work-item each; computes %tb_16; writes %tb_16
  k33: 20 elements, one work-item each; computes %eq_10 %f_13 %mul_12 %sub_17; writes %sub_17
  table55: 20 elements, one work-item each; computes %tb_17; writes %tb_17
  k35: 20 elements, one work-item each; computes %eq_11 %f_14 %mul_13 %sub_18 %sub_19 %gt_4 %f_15 %mul_14; writes %mul_14
launches:
  1: reduce_axis_max_float(b_m, b_maxr, 3, 4, 1) global 4 local 4: %maxr: max along axis 2: 3 lines of 4, one work-item each
  2: table1(b_maxr, b_b, b_tb) global 16 local 16: %tb: left table, 3 by 4 items
  3: k1(b_m, b_tb, b_f, b_mul) global 16 local 16: 12 elements (1 group of 16)
  4: table3(b_a, b_b_2, b_tb_2) global 16 local 16: %tb_2: right table, 3 by 4 items
  5: k3(b_f, b_tb_2, b_mul, b_add) global 16 local 16: 12 elements (1 group of 16)
  6: reduce_axis_min_float(b_add, b_minr, 3, 4, 1) global 4 local 4: %minr: min along axis 2: 3 lines of 4, one work-item each
  7: k4(b_minr, b_fl) global 4 local 4: 3 elements (1 group of 4)
  8: reduce_axis_min_float(b_m, b_minr_2, 3, 4, 1) global 4 local 4: %minr_2: min along axis 2: 3 lines of 4, one work-item each
