## Reference-inspired sphere/crystal composition diagnostic, using Scene v2.
## Opaque/mirror surfaces check framing before dielectric transport adoption.
"sc:" u_se< "Scene"
"gl:" u_se< "Glass"
"rt:" u_se< "RayTrace"
"studio" sc:s_cene2< "sphere mainball center 0 .85 0 radius .85 material solid\nsphere front center -1.55 .55 1.4 radius .55 material solid\nsphere rear center -1.7 .7 -1.6 radius .7 material solid\noctahedron right radii .55 .85 .55 material solid position 1.65 .85 .2\noctahedron frontgem radii .5 .65 .5 material solid position 2.9 .65 1.5\noctahedron backgem radii .65 1.05 .65 material solid position 1.5 1.05 -1.8\nfloor ground origin -12 0 -12 u 0 0 24 v 24 0 0 material slate\nfloor backpanel origin -4 3 -4 u 8 0 0 v 0 3 0 material panel\nfloor sidepanel origin -4 1 -3 u 0 4 0 v 0 0 4 material panel\nmaterial solid color .6 .68 .75 reflection .55\nmaterial slate color .025 .03 .035 reflection .35\nmaterial panel color 1 1 1 reflection 0\nlight key position 3 6 -3 color 260 245 225\nlight fill position -3 4 5 color 35 45 65\ncamera eye 5 2.8 7 target 0 .8 0 up 0 1 0 fov .6"
triangles := ((studiotriangles sc:a_pplyGroups studiogroupids)_ studiotransforms)
spheres := ((studiospheres sc:a_pplySphereGroups studiospheregroupids)_ studiotransforms)
geometry := (triangles, spheres)
links := (studiotriangleids, studiosphereids, studiotriangleobjectids, studiosphereobjectids, studiomaterialids, studiospherematerialids)
## Bright panels use ordinary emission arrays until the emitter DSL lands.
emission := sc:e_mission 3 3 r_eshape 0 0 0  0 0 0  5 5 5
shading := (studiomaterials, studiomaterialkind, studiooptics, emission, studiolights)
scene := (geometry gl:p_reflight links)_ shading
clip := 0.00001 100.0 1e-10 0.000001
ambient := 0.02 0.025 0.035
background := 0.04 0.055 0.075
width := 64
height := 64
cap := 4
origins := studiocamera rt:o_rigins width * height
directions := ((studiocamera rt:r_ays width c_at height)_ r_ange width * height)
mediumids := scene gl:m_ediums origins
sampleids := (r_ange width * height) - 1
linear := ((((((scene gl:r_ender clip)_ 2 3 r_eshape ambient c_at background)_ origins)_ directions)_ mediumids)_ sampleids)_ 123 c_at cap
1.0 rt:s_rgb linear
