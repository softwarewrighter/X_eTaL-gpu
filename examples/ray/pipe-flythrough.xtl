## Original periodic pipe corridor. Numeric geometry and camera rays are X_eTaL.
## Two pipes/gaps per 36-unit cell, red sphere right, gold pyramid left.
"rt:" u_se< "RayTrace"
## Two outward triangles from an ordered quad.
u:q_uad := { a b c d -> 2 3 3 r_eshape a c_at b c_at c c_at a c_at c c_at d }
## Circular point on a horizontal pipe whose bottom rests on y=0.
u:r_ing := { radius angle z -> (radius * c_os angle) c_at (2.2 + radius * s_in angle) c_at z }
## Hollow open pipe with inner/outer walls and annular rims, length 8.
u:p_ipe := { z ->
  step_ := { state ->
    (k, mesh) := state
    a := 6.283185307179586 * (f_loat k) / 16.0
    b := 6.283185307179586 * (f_loat k + 1) / 16.0
    p := ((2.2 u:r_ing a)_ z)
    q := ((2.2 u:r_ing b)_ z)
    r := ((2.2 u:r_ing b)_ z + 8.0)
    s := ((2.2 u:r_ing a)_ z + 8.0)
    t := ((1.9 u:r_ing a)_ z)
    v := ((1.9 u:r_ing b)_ z)
    w := ((1.9 u:r_ing b)_ z + 8.0)
    x := ((1.9 u:r_ing a)_ z + 8.0)
    faces := (((p u:q_uad q)_ r)_ s) c_at (((v u:q_uad t)_ x)_ w) c_at (((q u:q_uad p)_ t)_ v) c_at (((s u:q_uad r)_ w)_ x)
    (k + 1, mesh c_at faces)
  }
  (_, result) := 16 'step_ p_ower (0, 0 3 3 r_eshape 0.0)
  result
}
## UV sphere point; pole triangles below avoid degenerate faces.
u:s_pherePoint := { longitude latitude z ->
  (-3.6 + 1.15 * (c_os latitude) * c_os longitude) c_at (1.15 + 1.15 * s_in latitude) c_at z + 1.15 * (c_os latitude) * s_in longitude
}
## Red landmark to the right of the first exit, tessellated in X_eTaL.
u:s_phere := { z ->
  step_ := { state ->
    (k, mesh) := state
    j := k d_iv 12
    i := k m_od 12
    a := 6.283185307179586 * (f_loat i) / 12.0
    b := 6.283185307179586 * (f_loat i + 1) / 12.0
    c := -1.5707963267948966 + 3.141592653589793 * (f_loat j) / 6.0
    d := -1.5707963267948966 + 3.141592653589793 * (f_loat j + 1) / 6.0
    p := ((a u:s_pherePoint c)_ z)
    q := ((b u:s_pherePoint c)_ z)
    r := ((b u:s_pherePoint d)_ z)
    s := ((a u:s_pherePoint d)_ z)
    face_ := { @ -> j = 0 ? 1 3 3 r_eshape p c_at s c_at r; j = 5 ? 1 3 3 r_eshape p c_at r c_at q; (((p u:q_uad s)_ r)_ q) }
    (k + 1, mesh c_at face_ @)
  }
  (_, result) := 72 'step_ p_ower (0, 0 3 3 r_eshape 0.0)
  result
}
## Four-sided gold landmark to the left of the second exit.
u:p_yramid := { z ->
  a := 2.5 0.0 c_at z - 1.3
  b := 5.1 0.0 c_at z - 1.3
  c := 5.1 0.0 c_at z + 1.3
  d := 2.5 0.0 c_at z + 1.3
  top := 3.8 3.2 c_at z
  4 3 3 r_eshape a c_at top c_at b c_at b c_at top c_at c c_at c c_at top c_at d c_at d c_at top c_at a
}
## One periodic cell; end rings stay open for the centerline camera.
u:c_ell := { z -> (u:p_ipe z) c_at (u:p_ipe z + 18.0) c_at (u:s_phere z + 14.0) c_at u:p_yramid z + 32.0 }
cellids := (128 r_eshape 1 1 2 2 3 3 3 3) c_at (128 r_eshape 1 1 2 2 3 3 3 3) c_at (120 r_eshape 4) c_at 4 r_eshape 5
floor := (((-200.0 0.0 -200.0 u:q_uad -200.0 0.0 300.0)_ 200.0 0.0 300.0)_ 200.0 0.0 -200.0)
triangles := floor c_at (u:c_ell -36.0) c_at (u:c_ell 0.0) c_at (u:c_ell 36.0)
materialids := 6 6 c_at cellids c_at cellids c_at cellids
materials := 6 4 r_eshape 0.23 0.42 0.48 0.0 0.38 0.55 0.6 0.0 0.65 0.72 0.74 0.0 0.85 0.12 0.07 0.0 0.85 0.6 0.12 0.0 0.28 0.32 0.25 0.0
width := 2
height := 2
framecount := 180
batchframes := 2
frameStart := f_irst f_loor n_umbers []N_GET "frame-start.txt"
clip := 0.00001 32.0 1e-10 0.0001
environment := 2 3 r_eshape 0.28 0.3 0.34 0.22 0.48 0.8
## Flatten [frame,pixel,channel] so every batch is one parallel GPU region.
u:b_atch := { indices ->
  '{ index ->
    f := frameStart + (index - 1) d_iv (width * height * 3)
    pixel := 1 + ((index - 1) d_iv 3) m_od (width * height)
    channel := 1 + (index - 1) m_od 3
    phase := 36.0 * (f_loat (f m_od framecount)) / f_loat framecount
    camera := 0.0 2.15 c_at phase c_at 0.0 2.15 c_at (phase + 5.0) c_at 0.0 1.0 0.0 1.05
    o := camera rt:o_rigins 1
    d := ((camera rt:r_ays width c_at height)_ 1 r_eshape pixel)
    lights := 2 6 r_eshape -6.0 12.0 c_at (phase - 5.0) c_at 100.0 95.0 85.0 -0.4 3.1 c_at (phase - 1.0) c_at 7.0 7.5 8.0
    color := (((((((clip rt:s_hade triangles)_ materialids)_ materials)_ lights)_ environment)_ o)_ d)
    channel s_elect r_avel color
  } e_ach indices
}
## A bound zero term keeps the function index vector device-valued for scalar each regions.
indices := (f_loor f_loat r_ange batchframes * width * height * 3) + 0 * frameStart
linear := ((batchframes * width * height) c_at 3) r_eshape u:b_atch indices
r_avel linear
r_avel 1.0 rt:s_rgb linear
