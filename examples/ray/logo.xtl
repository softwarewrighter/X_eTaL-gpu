#!/usr/bin/env xetal
## CPU/GPU-independent logo scene using committed Scene and RayTrace libraries.
## Scene declaration adapted from X_eTaL-libraries Scene demo, MIT, 7bd8f0a.
"sc:" u_se< "Scene"
"rt:" u_se< "RayTrace"
"logo" sc:s_cene< "# References precede their declarations.\ngroup fixed objects x\ngroup vane objects tail pivot 1.2 0 0\nobject x extrude X depth .3 material silver\nobject tail extrude _eTaL depth .2 material copper position 1.2 0 0\nmaterial copper color .8 .3 .1 reflection .2\nmaterial silver color .8 .8 .85 reflection .3\nlight key position 2 5 8 color 200 200 200\ncamera eye 3.3 .4 10 target 3.3 .4 0 up 0 1 0 fov .18\n"
width := 64
height := 16
angle := 0.35
transforms := (((logopivots sc:r_otateGroup 3)_ angle)_ logotransforms)
triangles := ((logotriangles sc:a_pplyGroups logogroupids)_ transforms)
pixels := r_ange (width * height)
origins := logocamera rt:o_rigins (width * height)
directions := ((logocamera rt:r_ays (width c_at height))_ pixels)
clip := 1e-6 100.0 1e-10 1e-5
environment := 2 3 r_eshape 0.05 0.05 0.05  0.01 0.02 0.04
linear := (((((((clip rt:r_ender triangles)_ logomaterialids)_ logomaterials)_ logolights)_ environment)_ origins)_ directions)
1.0 rt:s_rgb linear
