# The twin of lookup.xtl, lowered by hand (docs/xetal-asks.md, G2).
%v = const i64 [5] 10 20 30 40 50
%two = const i64 [] 2
%a = lookup %two %v                   # 2 s_elect v
output %a
%i3 = const i64 [3] 2 4 1
%b = lookup %i3 %v                    # 2 4 1 s_elect v
output %b
%i22 = const i64 [2 2] 2 4 1 1
%c = lookup %i22 %v                   # (2 2 r_eshape 2 4 1 1) s_elect v
output %c
%m = const i64 [3 2] 1 2 3 4 5 6
%r = const i64 [2] 3 1
%d = lookup %r %m                     # 3 1 s_elect m: rows
output %d
%cs = const i64 [2] 2 1
%f = lookup axis=2 %cs %m             # 2 1 s_elect_2 m: columns
output %f
%t = const f64 [5 4] 0.0 0.1 0.2 0.3 1.0 1.1 1.2 1.3 2.0 2.1 2.2 2.3 3.0 3.1 3.2 3.3 4.0 4.1 4.2 4.3
%ids = const i64 [2 3] 1 5 2 4 4 3
%e = lookup %ids %t                   # t ac:e_mbed ids: ids s_elect t, [2 3 4]
output %e
%s = reduce add axis=2 %e             # '+ r_/_2 e
output %s
