#!/usr/bin/env xetal
# Choices: the position of each row's largest item (the first on a
# tie) and a mask of each row's two largest, then the two together on
# a batch of scores: the chosen class and the candidate set. Both are
# compositions of row reductions, tables and masks, so the GPU runs
# them with the kernels it has; no new operation. Run with
# "just demo-lib Accel topk".
"ac:" u_se< "Accel"
m := 3 4 r_eshape 5.0 1.0 9.0 9.0 2.0 2.0 2.0 2.0 7.0 8.0 6.0 8.0
ac:a_rgmax m
2 ac:t_opk m
1 ac:t_opk m
s := 4 5 r_eshape 0.1 0.5 0.15 0.25 0.0 -1.0 2.0 2.0 1.5 0.5 3.0 1.0 2.0 4.0 0.0 0.2 0.1 0.9 0.3 0.4
ac:a_rgmax s
3 ac:t_opk s
s * 3 ac:t_opk s
